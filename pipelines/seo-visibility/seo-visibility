# ---------------------------------------------------------------- run one job

def cmd_run(slug, jtype, period=None, force=False):
    cfg = load_config()
    site = load_site(slug)
    if not site:
        print("no site.json for %s" % slug)
        return 2
    period = period or ("initial" if jtype == "baseline" else today().isoformat())
    key = "%s|%s|%s" % (slug, jtype, period)
    os.makedirs(STATE_DIR, exist_ok=True)
    lockf = open(os.path.join(STATE_DIR, slug + ".lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        with Locked() as st:
            r = st["running"].get(key)
            if r and r.get("pid") == os.getpid() or (r and not pid_alive(r.get("pid"))):
                del st["running"][key]
        print("another job holds the %s lock" % slug)
        return 3
    with Locked() as st:
        st["running"][key] = {"pid": os.getpid(), "started": iso()}
        j = st["jobs"].setdefault(key, {"attempts": 0})
        j["attempts"] = j.get("attempts", 0) + 1
        j["last_attempt"] = iso()
        j["status"] = "running"
    log("run start %s" % key)
    rc, info = 1, {}
    try:
        if jtype in AUDIT_TYPES:
            rc, info = run_audit(cfg, site, slug, jtype, period)
        elif jtype == "implement":
            rc, info = run_implement(cfg, site, slug, period)
        elif jtype in ("validate-d7", "validate-d28"):
            rc, info = run_validation(cfg, site, slug, period, jtype.split("-")[1])
        else:
            info = {"note": "unknown job type"}
    except Exception:
        tb = traceback.format_exc()
        info = {"note": "exception: " + tb[-1500:]}
        rc = 1
        if GIT_AUTH_RE.search(tb):
            info = {"note": "deferred: git cannot authenticate to GitHub (gh auth token invalid). "
                            "Fix: gh auth login -h github.com"}
            rc = 75
            alert_once("git-auth", "SEO visibility is paused: git cannot authenticate to GitHub, so no clone can "
                       "fetch and nothing can ship. Every repo on the Mac is affected, not just this pipeline. "
                       "Fix with: gh auth login -h github.com  (git's helper for github.com is `gh auth "
                       "git-credential`, and `gh auth status` reports the token invalid). Jobs resume by themselves.",
                       every_hours=12)
        elif NETWORK_RE.search(tb):
            # an offline or sleeping Mac is not the job's fault; do not spend one of its attempts on it
            info = {"note": "deferred: no network (%s)" % NETWORK_RE.search(tb).group(0)}
            rc = 75
    with Locked() as st:
        st["running"].pop(key, None)
        j = st["jobs"].setdefault(key, {})
        j.update({k: v for k, v in info.items() if k in ("note", "run_dir", "changeset")})
        if rc == 0:
            j["status"] = "done"
            j["finished"] = iso()
            if jtype == "baseline" and info.get("sha"):
                st["baselines"][slug] = {"date": today().isoformat(), "sha": info["sha"],
                                         "run_dir": info.get("run_dir")}
        elif rc == 2:
            j["status"] = "skipped"
        elif rc == 75:
            j["status"] = "deferred"
            j["attempts"] = max(0, j.get("attempts", 1) - 1)
            j["deferrals"] = j.get("deferrals", 0) + 1
            if j["deferrals"] >= 5:
                j["status"] = "failed"   # stop retrying every 30 minutes and say so
                j["note"] = "deferred %d times in a row, last reason: %s" % (j["deferrals"], (info.get("note") or "")[:200])
                deferral_wall = key
        else:
            j["status"] = "failed"
        attempts, status = j.get("attempts", 0), j["status"]
        deferral_wall = locals().get("deferral_wall")
    log("run end %s rc=%s %s" % (key, rc, (info.get("note") or "")[:300]))
    if deferral_wall:
        alert_once("deferwall-%s" % slug, "SEO visibility: %s kept deferring (5 times in a row) and has stopped retrying. "
                   "Last reason: %s. Check %s/seo-visibility.log" % (deferral_wall, (info.get("note") or "")[:200], LOGS),
                   every_hours=12)
    if status == "failed" and attempts >= cfg["max_attempts"]:
        lark("SEO visibility: %s %s (%s) failed %d times and will not retry this period. %s Log: %s"
             % (slug, jtype, period, attempts, (info.get("note") or "")[:300],
                info.get("run_dir") or os.path.join(LOGS, "seo-visibility.log")))
    write_status()
    return rc


# ---------------------------------------------------------------- clone management

def prepare_clone(site, slug, branch=None):
    """A private APFS clone of the shared checkout, reset to origin/main.

    The shared checkout belongs to other sessions (often dirty or behind) and a
    fresh worktree of the static mirrors costs 0.8-1.8 GB on a nearly full disk;
    `cp -c` shares blocks, so only files that differ from the checkout use space.
    """
    work = os.path.join(WORK, slug)
    repo = site["repo_path"]
    main = site.get("default_branch", "main")
    if not os.path.isdir(os.path.join(work, ".git")):
        os.makedirs(WORK, exist_ok=True)
        if os.path.exists(work):
            shutil.rmtree(work)
        # pipeline.clone_from_remote: never copy the checkout (it holds live secrets or nested worktrees)
        if pipe(site).get("clone_from_remote"):
            rc, out = 1, "clone_from_remote is set"
        else:
            rc, out = sh(["cp", "-cR", repo, work], timeout=1800, check=False)
        if rc != 0:  # launchd cannot read ~/Documents; fall back to a fresh clone from GitHub
            if os.path.exists(work):
                shutil.rmtree(work)
            if disk_free_gb() < load_config()["min_free_gb"] + 4:
                raise RuntimeError("clone for %s is missing, copying the checkout failed (%s) and there is not enough "
                                   "disk for a fresh clone; run `seo-visibility reclone %s` from a Claude session" % (slug, out[-200:], slug))
            sh(["git", "clone", site.get("git_remote"), work], check=True, timeout=3600)
        git(work, "worktree", "prune", check=False)
    for lock in glob.glob(os.path.join(work, ".git", "*.lock")):
        os.remove(lock)
    if os.path.isdir(os.path.join(work, ".git", "rebase-merge")) or os.path.isdir(os.path.join(work, ".git", "rebase-apply")):
        git(work, "rebase", "--abort", check=False)
    # Refresh stat info first: an APFS clone gives every file a new inode/ctime, and a forced
    # checkout would then rewrite all of them (800 MB for cleaningco) and undo the block sharing.
    git(work, "update-index", "-q", "--refresh", check=False, timeout=900)
    git(work, "reset", "-q", "--hard", timeout=900)
    git(work, "fetch", "origin", "--prune", timeout=900)
    git(work, "checkout", "-q", "--detach", "origin/" + main, timeout=900)
    git(work, "reset", "-q", "--hard", "origin/" + main, timeout=900)
    git(work, "clean", "-fdq", timeout=600)
    # `cp -c` also copies git-ignored files, so a checkout's .env.local with live keys would sit in the clone
    # where agents can read it. pipeline.strip_ignored lists globs of ignored files to delete (e.g. "**/.env*").
    # (`git clean -dX` with a glob also drops whole ignored folders such as node_modules, so list files instead.)
    strip = pipe(site).get("strip_ignored") or []
    if strip:
        listed = git(work, "ls-files", "-z", "--others", "--ignored", "--exclude-standard", "--",
                     *[":(glob)" + g for g in strip], timeout=600)
        for rel in filter(None, listed.split("\0")):
            if "node_modules/" not in rel:
                os.remove(os.path.join(work, rel))
    # agents run with full shell access in this clone: disable pushing through origin so the only push is the
    # scheduler's own explicit `git push <git_remote>` after the gate and the pre-push re-check
    git(work, "remote", "set-url", "--push", "origin", "PUSH-DISABLED-use-seo-visibility")
    for p in (site.get("worktree_deploy") or {}).get("copy_paths") or []:
        src, dst = os.path.join(repo, p), os.path.join(work, p)
        if os.path.exists(src) and not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            sh(["cp", "-cR", src, dst], check=True)
    if branch:
        git(work, "checkout", "-B", branch)
    for b in git(work, "branch", "--format=%(refname:short)").splitlines():
        if b.startswith("seo/") and b != branch:
            git(work, "branch", "-D", b, check=False)
    return work, git(work, "rev-parse", "HEAD")


def new_run_dir(slug, name):
    base = os.path.join(sp(slug)["runs"], "%s-%s" % (today().isoformat(), name))
    d, n = base, 2
    while os.path.exists(d):
