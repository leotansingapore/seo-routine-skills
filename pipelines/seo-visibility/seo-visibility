def match_path(path, patterns):
    for pat in patterns or []:
        pat = str(pat).lstrip("/")
        if not pat:
            continue
        if pat.endswith("/"):
            if path.startswith(pat):
                return pat
        elif any(ch in pat for ch in "*?["):
            if fnmatch.fnmatch(path, pat):
                return pat
        elif path == pat or path.startswith(pat + "/"):
            return pat
    return None


def guard_patterns(site, items):
    """Marker guards, plus the files where one marker is exempt.

    Deleting a JSON-LD block is the whole point of a structured_data_fix, so the ld+json marker is waived - but only
    in the files that such an item names. Waiving it for the whole change set would let an unrelated item strip schema
    from any file; requiring every item to be schema work made a mixed change set unable to ship the removal at all
    (vepco-20260915-1644)."""
    patterns = list(pipe(site).get("guard_removed_patterns") or [])
    exempt = set()
    for i in items or []:
        if i.get("change_class") == "structured_data_fix":
            exempt.update(str(f).split(" ")[0].strip().lstrip("/") for f in (i.get("files") or []))
    return patterns, {"application/ld+json": exempt}


def check_diff(cfg, site, work, items, base_ref):
    """Deterministic merge preconditions. Returns (ok, reason, files)."""
    out = git(work, "diff", "--name-only", "--no-renames", "%s...HEAD" % base_ref)
    files = [f for f in out.splitlines() if f]
    if not files:
        return False, "no file changes", files
    if len(files) > cfg["implement"]["max_files"]:
        return False, "%d files changed (cap %d)" % (len(files), cfg["implement"]["max_files"]), files
    rc, dirty = git(work, "status", "--porcelain", "--untracked-files=no", check=False)
    if dirty.strip():
        return False, "uncommitted changes left in the clone", files
    want = pipe(site).get("required_author_email")
    authors = set(git(work, "log", "--format=%ae", "%s..HEAD" % base_ref).split())
    if want and authors - {want}:
        return False, "commit author %s is not %s (Vercel would block the deploy)" % (
            ", ".join(sorted(authors - {want})), want), files
    never = pipe(site).get("never_touch") or []
    protected = (pipe(site).get("protected") or []) + ALWAYS_PROTECTED
    generated = pipe(site).get("allow_generated_paths") or []
    owner_files, owner_ok, owner_pats = [], False, []
    for i in items:
        if str(i.get("approved_by", "")).startswith(OWNER_APPROVERS):
            # auditors annotate paths ("src/pages/Pricing.tsx (protected)"): match on the path itself
            owner_files += [f for f in (str(x).split(" ")[0].strip().lstrip("/") for x in (i.get("files") or []))
                            if f and not any(ch in f for ch in "*?[")]
            # an item that names a family ("blogs/<slug>/index.html (305 files)") covers one path segment per placeholder
            owner_pats += [re.compile(re.sub(r"<[^>/]+>", "[^/]+", re.escape(f).replace(r"\<", "<").replace(r"\>", ">")))
                           for f in owner_files if "<" in f]
            owner_ok = owner_ok or i.get("change_class") == "tracking_or_consent"
    owner_ok = owner_ok and all(i.get("change_class") == "tracking_or_consent" for i in items)
    for f in files:
        hit = match_path(f, never)
        if hit:
            return False, "touched never-touch path %s (%s)" % (f, hit), files
        hit = match_path(f, protected)
        if (hit and not match_path(f, owner_files) and not match_path(f, generated)
                and not any(p.fullmatch(f) for p in owner_pats)):
            return False, "touched protected path %s (%s) without an owner-approved item naming it" % (f, hit), files
    # a net loss of tracking, lead-capture or structured-data markers means something was removed, not fixed
    patterns, exemptions = guard_patterns(site, items)
    if patterns and not owner_ok:
        rc, diff = git(work, "diff", "--unified=0", "--no-renames", "%s...HEAD" % base_ref, check=False, timeout=600)
        removed = {p: 0 for p in patterns}
        added = {p: 0 for p in patterns}
        current = ""
        for line in diff.splitlines():
            if line.startswith("diff --git "):
                current = line.split(" b/")[-1].strip()
                continue
            if line.startswith("---") or line.startswith("+++"):
                continue
            if line.startswith("-") or line.startswith("+"):
                bucket = removed if line[0] == "-" else added
                for p in patterns:
                    if current in exemptions.get(p, set()):
                        continue  # this file is where the approved schema fix does its work
                    bucket[p] += line.count(p)
        lost = ["%s (-%d/+%d)" % (p, removed[p], added[p]) for p in patterns if removed[p] > added[p]]
        if lost:
            return False, "net removal of guarded markers: %s" % ", ".join(lost), files
    return True, "", files


def run_build(cfg, site, work, log_path):
    b = pipe(site)
    steps = []
    if b.get("install"):
        lock = os.path.join(work, "package-lock.json")
        stamp = os.path.join(work, "node_modules", ".seo-visibility-lock")
        digest = hashlib.sha1(open(lock, "rb").read()).hexdigest() if os.path.exists(lock) else ""
        have = open(stamp).read().strip() if os.path.exists(stamp) else None
        if not os.path.isdir(os.path.join(work, "node_modules")) or have != digest:
            if disk_free_gb() < cfg["min_free_gb"] + 1.5:
                return False, "not enough disk for a dependency install (%.1f GB free)" % disk_free_gb()
            steps.append(("install", b["install"], stamp, digest))
    if b.get("build"):
        steps.append(("build", b["build"], None, None))
    for n, c in enumerate(b.get("checks") or []):
        steps.append(("check%d" % (n + 1), c, None, None))
    with open(log_path, "a") as lf:
        for name, cmd, stamp, digest in steps:
            lf.write("\n==== %s %s: %s\n" % (iso(), name, cmd))
            lf.flush()
            try:
                p = subprocess.run(["/bin/bash", "-lc", cmd], cwd=work, stdin=subprocess.DEVNULL, stdout=lf,
                                   stderr=lf, timeout=cfg["timeouts_min"]["build"] * 60,
                                   env=dict(os.environ, PATH=PATH_ENV, CI="1"))
                rc = p.returncode
            except subprocess.TimeoutExpired:
                rc = 124
            if rc != 0:
                return False, "%s failed (rc=%s): %s" % (name, rc, cmd)
            if stamp:
                with open(stamp, "w") as s:
                    s.write(digest)
    # builds may regenerate tracked files (sitemaps); never let that ride into a merge
    git(work, "checkout", "--", ".", check=False)
    git(work, "clean", "-fd", check=False)
    return True, ""


def items_table(items):
    rows = []
    for i in items:
        rows.append("- %s [%s %s, %s] %s\n    urls: %s\n    files: %s\n    evidence: <<<UNTRUSTED>>>%s<<<END>>>\n    action: <<<UNTRUSTED>>>%s<<<END>>>\n    validation: <<<UNTRUSTED>>>%s<<<END>>>\n    approved by: %s on %s; found in %s%s" % (
            i["id"], i.get("severity"), i.get("change_class"), i.get("confidence"), i.get("title"),
            ", ".join((i.get("urls") or [])[:12]), ", ".join((i.get("files") or [])[:12]),
            (i.get("evidence") or "")[:600], (i.get("action") or "")[:600], (i.get("validation") or "")[:400],
            i.get("approved_by"), i.get("approved_at"), i.get("last_run"),
            ("\n    owner answer (use these exact values): %s" % i["owner_note"]) if i.get("owner_note") else ""))
    return "\n".join(rows)


