    pj = read_json(os.path.join(work, ".vercel", "project.json"), {}) or {}
    org = pipe(site).get("vercel_team_id") or pj.get("orgId") or ""
    return org if org.startswith("team_") else ""


def deployments_query(site, work, limit=30):
    team = vercel_team(site, work)
    return "/v6/deployments?projectId=%s&target=production&limit=%d%s" % (
        pipe(site).get("vercel_project_id"), limit, "&teamId=" + team if team else "")


def latest_production(site, work):
    for d in vercel_get(deployments_query(site, work, 10)).get("deployments", []):
        if (d.get("state") or d.get("readyState")) == "READY":
            return {"sha": (d.get("meta") or {}).get("githubCommitSha"), "url": d.get("url"), "created": d.get("created")}
    return None


def wait_git_deploy(site, work, sha, log_path, timeout_s=1500, poll_s=20, missing_after=600):
    """Waits for Vercel's production build of `sha`. Returns (state, detail, api_errors).

    MISSING means the API answered and never listed the commit; UNKNOWN means the API kept failing, so
    nothing may be concluded (never a reason for a CLI deploy or a revert)."""
    q = deployments_query(site, work)
    t0, seen, errors = time.time(), None, 0
    while time.time() - t0 < timeout_s:
        try:
            for d in vercel_get(q).get("deployments", []):
                if (d.get("meta") or {}).get("githubCommitSha") == sha:
                    seen = d
                    break
        except Exception as e:
            errors += 1
            with open(log_path, "a") as lf:
                lf.write("vercel poll error: %s\n" % e)
        if seen:
            state = seen.get("state") or seen.get("readyState")
            if state == "READY":
                return "READY", seen.get("url"), errors
            if state in ("ERROR", "CANCELED"):
                return state, seen.get("url"), errors
            if state not in ("BUILDING", "QUEUED", "INITIALIZING") and time.time() - t0 > 180:
                if state not in ("BLOCKED",):
                    return "UNKNOWN", "%s %s" % (state, seen.get("uid")), errors
                return "BLOCKED", "%s %s" % (state, seen.get("uid")), errors
        elif time.time() - t0 > missing_after:
            if errors:
                return "UNKNOWN", "Vercel API failed %d times; deployment state unknown" % errors, errors
            return "MISSING", "no deployment for %s after %ds" % (sha[:9], missing_after), errors
        time.sleep(poll_s)
    return "TIMEOUT", "no READY after %ds" % timeout_s, errors


def cli_deploy(site, work, log_path):
    scope = pipe(site).get("vercel_scope")
    if not os.path.exists(os.path.join(work, ".vercel", "project.json")):
        src = os.path.join(site["repo_path"], ".vercel", "project.json")
        if os.access(src, os.R_OK):
            os.makedirs(os.path.join(work, ".vercel"), exist_ok=True)
            shutil.copy(src, os.path.join(work, ".vercel", "project.json"))
    linked = read_json(os.path.join(work, ".vercel", "project.json"), {}) or {}
    if linked.get("projectId") != pipe(site).get("vercel_project_id"):
        return False, "refusing vercel --prod: %s is not linked to project %s" % (work, pipe(site).get("vercel_project_id"))
    args = ["vercel", "--prod", "--yes"] + (["--scope", scope] if scope else [])
    with open(log_path, "a") as lf:
        lf.write("\n==== %s %s\n" % (iso(), " ".join(args)))
        lf.flush()
        try:
            p = subprocess.run(args, cwd=work, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=lf,
                               timeout=1800, env=dict(os.environ, PATH=PATH_ENV))
        except subprocess.TimeoutExpired:
            return False, "vercel --prod timed out"
        out = p.stdout.decode("utf-8", "replace")
        lf.write(out)
    urls = re.findall(r"https://\S+\.vercel\.app", out)
    return p.returncode == 0, (urls[-1] if urls else out[-300:])


def push_and_deploy(cfg, site, work, log_path, retries=2, recheck=None):
    """Rebase onto the newest origin, rebuild if others moved it, re-check, push, deploy. Returns (ok, info).

    info["pushed_at"] is set only once main really moved. info["stage"] names a failure: rebase,
    build-after-rebase, recheck, push (nothing reached main); deploy (pushed, the build failed or was
    cancelled for good: revert); deploy-unknown (pushed, outcome unknown: never auto-revert)."""
    main = site.get("default_branch", "main")
    remote = site.get("git_remote")
    if not remote:
        return False, {"stage": "push", "detail": "site.json has no git_remote"}
    commits, pushed, attempted = [], False, []
    for attempt in range(retries):
        before = git(work, "rev-parse", "origin/" + main)
        git(work, "fetch", "origin", timeout=900)
        after = git(work, "rev-parse", "origin/" + main)
        rc, out = git(work, "rebase", "origin/" + main, check=False)
        if rc != 0:
            git(work, "rebase", "--abort", check=False)
            return False, {"stage": "rebase", "detail": out[-500:]}
        if before != after:
            ok, why = run_build(cfg, site, work, log_path)
            if not ok:
                return False, {"stage": "build-after-rebase", "detail": why}
        if recheck:
            ok, why = recheck()
            if not ok:
                return False, {"stage": "recheck", "detail": why}
        commits = git(work, "rev-list", "--reverse", "origin/%s..HEAD" % main).split()
        if not commits and attempted:
            # an earlier push reached the remote but the client lost the answer: origin/main now contains HEAD
            commits, pushed = attempted, True
            with open(log_path, "a") as lf:
                lf.write("push reported failure but origin/%s already contains HEAD: treating as pushed\n" % main)
            break
        if not commits:
            return False, {"stage": "push", "detail": "nothing to push"}
        attempted = commits
        # the clone's origin has its push URL disabled so no agent can push; this is the only push
        rc, out = git(work, "push", remote, "HEAD:" + main, check=False, timeout=900)
        if rc == 0:
            pushed = True
            break
        with open(log_path, "a") as lf:
            lf.write("push rejected (attempt %d): %s\n" % (attempt + 1, out[-400:]))
    if not pushed:
        git(work, "fetch", "origin", check=False, timeout=900)
        rc, _ = git(work, "merge-base", "--is-ancestor", git(work, "rev-parse", "HEAD"), "origin/" + main, check=False)
        if rc != 0:
            return False, {"stage": "push", "detail": "push rejected %d times" % retries}
        with open(log_path, "a") as lf:
            lf.write("push reported failure but origin/%s contains HEAD: treating as pushed\n" % main)
    head = git(work, "rev-parse", "HEAD")
    git(work, "fetch", "origin", check=False, timeout=900)
    mode = pipe(site).get("deploy_mode", "push")
    info = {"commits": commits, "head": head, "pushed_at": iso(), "mode": mode}
    if mode != "push":
        ok, detail = cli_deploy(site, work, log_path)
        info["cli_deploy"] = [ok, detail]
        return ok, (info if ok else dict(info, stage="deploy"))
    state, detail, errors = wait_git_deploy(site, work, head, log_path)
    info["git_deploy"] = [state, detail, errors]
    if state == "READY":
        return True, info
    if state == "BLOCKED":
        ok, detail = cli_deploy(site, work, log_path)  # COMMIT_AUTHOR_REQUIRED blocks git builds, not the CLI
        info["cli_fallback"] = [ok, detail]
        return ok, (info if ok else dict(info, stage="deploy"))
    if state in ("CANCELED", "TIMEOUT", "UNKNOWN", "MISSING"):
        # a newer push that contains ours cancels our build; a slow queue may still land it
        deadline = time.time() + (600 if state == "CANCELED" else 60)
        while True:
            try:
                prod = latest_production(site, work)
            except Exception:
                prod = None
            if prod and prod.get("sha"):
                git(work, "fetch", "origin", check=False, timeout=900)
                rc, _ = git(work, "merge-base", "--is-ancestor", head, prod["sha"], check=False)
                if rc == 0:
                    info["note"] = "live via %s" % prod["sha"][:9]
                    return True, info
            if time.time() >= deadline:
                break
            time.sleep(30)
        return False, dict(info, stage="deploy-unknown")  # a cancel is usually a superseding build: never auto-revert
    git(work, "fetch", "origin", check=False, timeout=900)
    if git(work, "rev-parse", "origin/" + main) != head:
        return False, dict(info, stage="deploy-unknown")  # a peer pushed after us: the failure may be theirs
    return False, dict(info, stage="deploy")  # ERROR on our own HEAD: the pushed commit breaks the build


def revert_changeset(cfg, site, slug, cs, reason, log_path):
    work, _ = prepare_clone(site, slug)
    for c in reversed(cs.get("commits", [])):
        rc, out = git(work, "revert", "--no-commit", c, check=False)
        if rc != 0:
            git(work, "revert", "--abort", check=False)
            git(work, "reset", "-q", "--hard", check=False)
            return False, "revert of %s conflicted: %s" % (c[:9], out[-300:])
    rc, dirty = git(work, "status", "--porcelain", "--untracked-files=no", check=False)
    if not dirty.strip():
        return True, "nothing left to revert (already reverted upstream)"
    git(work, "commit", "-q", "-m", "fix: revert changeset %s after a live regression" % cs["id"], "-m",
        "[seo-visibility] changeset %s revert\n\n%s\n\nCo-Authored-By: Claude <noreply@anthropic.com>" % (cs["id"], reason[:500]))
    ok, info = push_and_deploy(cfg, site, work, log_path)
    return ok, json.dumps(info)[:600]


def gate_mergeable(gate, large_change, owner_approved=True):
    """Merge only on an explicit, internally consistent GO. A warning must say blocking=false to be ignored."""
    if not isinstance(gate, dict):
        return False
    verdict = str(gate.get("verdict", "")).upper().strip()
    warnings = gate.get("warnings") or []
    blocking_warn = any((not isinstance(w, dict)) or w.get("blocking") is not False for w in warnings)
    # large_change is no longer a veto: a sitewide but mechanical fix rarely earns a bare GO, and it is already held by
    # the path/marker guards, the pre-push recheck, the live check and automatic revert. Discipline stays: an explicit
    # merge_ok, zero blockers, and every warning marked blocking:false (an unmarked warning still blocks).
    if not (verdict in ("GO", "GO WITH WARNINGS") and gate.get("merge_ok") is True and not gate.get("blockers")
            and not blocking_warn):
        return False
    # a sweep nobody named needs an unqualified GO; an owner-approved sweep may carry non-blocking warnings
    return verdict == "GO" or owner_approved or not large_change


def mark_shipped(cfg, slug, cs, ids, statuses, skipped, note=None):
    d = today()
    cs["state"] = "shipped"
    val = cs.setdefault("validation", {})
    val.setdefault("immediate", {"verdict": note or "unverified", "at": iso()})
    val["d7"] = {"due": (d + dt.timedelta(days=7)).isoformat()}
    val["d28"] = {"due": (d + dt.timedelta(days=28)).isoformat()}
    if note:
        cs.setdefault("notes", []).append(note)
    save_cs(slug, cs)
    blk = load_backlog(slug)
    for i in ids:
        it = blk["items"].get(i)
        if not it or it.get("state") != "in_progress":
            continue  # the owner changed it mid-run; their decision stands
        s = statuses.get(i)
        if i in skipped or s == "not_fixed":
            exhausted = it.get("impl_attempts", 0) >= cfg["implement"]["max_impl_attempts"]
            it["state"] = "blocked" if exhausted else "approved"
            if exhausted:
                it["blocked_reason"] = "not fixed after %d attempts" % it.get("impl_attempts", 0)
        else:
            it.update({"state": "shipped", "shipped_in": cs["id"], "live_status": s or "cannot_verify"})
    save_backlog(slug, blk)


def run_implement(cfg, site, slug, period):
    try:
        return _run_implement(cfg, site, slug, period)
    except Exception as e:
        log("implement %s crashed: %s" % (slug, traceback.format_exc()[-1500:]))
        try:
            msgs = repair_stuck(slug, "implement crashed: %s" % str(e)[:200])
        except Exception as e2:
            msgs = ["SEO visibility: %s implement crashed (%s) and its cleanup failed too (%s). Check %s" % (
                slug, str(e)[:200], str(e2)[:200], sp(slug)["changes"])]
        for m in msgs:
            lark(m)
        if not msgs:
            alert_once("implement-crash-%s" % slug, "SEO visibility: %s implement crashed before a change set "
                       "existed (nothing pushed): %s" % (slug, str(e)[:300]), every_hours=24)
        raise


def _run_implement(cfg, site, slug, period):
    ok, why = implement_allowed(cfg, site)
    if not ok:
        return 2, {"note": why}
    if blackout_active(site, now()):
        return 75, {"note": "deploy blackout window"}
    items = approved_items(slug, cfg, consume=True)
    if not items:
        return 2, {"note": "nothing approved"}
    ids = [i["id"] for i in items]
    work, base = prepare_clone(site, slug)
    blocked = preflight(site, work)
    if blocked:
        if any("unpushed" in r or "cannot read" in r for r in blocked):
            alert_once("preflight-%s" % slug, "SEO visibility: holding fixes for %s: %s" % (slug, "; ".join(blocked)),
                       every_hours=72)
        return 75, {"note": "preflight: " + "; ".join(blocked)}

    cs_id = "%s-%s" % (slug, now().strftime("%Y%m%d-%H%M"))
    cs_dir = os.path.join(sp(slug)["cs"], cs_id)
    os.makedirs(cs_dir, exist_ok=True)
    log_path = os.path.join(cs_dir, "pipeline.log")
    git(work, "checkout", "-q", "-B", "seo/" + cs_id)
    cs = {"id": cs_id, "created": iso(), "state": "implementing", "items": ids, "branch": "seo/" + cs_id,
          "commits": [], "validation": {}, "notes": []}
    save_cs(slug, cs)
    write_json(os.path.join(cs_dir, "scope.json"), {"items": items})
    bl = load_backlog(slug)
    for i in ids:
        bl["items"][i].update({"state": "in_progress", "changeset": cs_id,
                               "impl_attempts": bl["items"][i].get("impl_attempts", 0) + 1})
    save_backlog(slug, bl)

    def abandon(state, note, item_state="approved"):
        cs["state"], cs["notes"] = state, cs["notes"] + [note]
        save_cs(slug, cs)
        blk = load_backlog(slug)
        for i in ids:
            it = blk["items"].get(i)
            if it and it.get("state") == "in_progress":
                exhausted = it.get("impl_attempts", 0) >= cfg["implement"]["max_impl_attempts"]
                it["state"] = "blocked" if exhausted else item_state
                it["blocked_reason"] = note if exhausted or item_state != "approved" else None
                if item_state == "owner_action":
                    it["no_op_at"] = today().isoformat()   # classify keeps it with Leo; re-approving loops
        save_backlog(slug, blk)
        return 1, {"note": "%s: %s" % (state, note), "changeset": cs_id, "run_dir": cs_dir}

    def refund(note):
        blk = load_backlog(slug)
        for i in ids:
            it = blk["items"].get(i)
            if it and it.get("state") == "in_progress":
                it["state"] = "approved"
                it["impl_attempts"] = max(0, it.get("impl_attempts", 1) - 1)
        save_backlog(slug, blk)
        drop_cs(slug, cs_id)
        with open(log_path, "a") as lf:
            lf.write("%s not attempted: %s\n" % (iso(), note))

    def defer(note):
        refund(note)
        if LAST_DEFER.get("timeout") and len(ids) > 1:
            blk = load_backlog(slug)   # a set too big to finish in time: the next run takes one item
            blk["shrink_next"] = True
            save_backlog(slug, blk)
        return 75, {"note": "deferred: " + note}

    red_path = os.path.join(STATE_DIR, "red-main.json")
    red = read_json(red_path, {}) or {}
    if red.get(slug, {}).get("sha") == base:
        # same broken commit as last time: rebuilding only rediscovers it (15 runs in Sep 2026)
        refund("base does not build (cached for %s): %s" % (base[:8], red[slug]["why"]))
        return 2, {"note": "origin/main does not build (unchanged since %s): %s" % (red[slug]["at"], red[slug]["why"])}
    ok, why = run_build(cfg, site, work, log_path)  # proves the base builds before blaming the change
    red = read_json(red_path, {}) or {}
    if ok and slug in red:
        red.pop(slug)
        write_json(red_path, red)
    if not ok and not re.search(r"disk|rc=124|timed out", why):   # transient: worth trying again
        red[slug] = {"sha": base, "why": why[:300], "at": iso()}
        write_json(red_path, red)
    if not ok:
        refund("base does not build: " + why)
        alert_once("base-build-%s" % slug, "SEO visibility: holding fixes for %s because origin/main itself does not "
                   "build: %s" % (slug, why[:300]), every_hours=72)
        return 2, {"note": "origin/main does not build: " + why}
    add = [cs_dir, "/private/tmp"]
    rc = claude(cfg, "implement", read_prompt("implement") + "\n" + implement_context(
        cfg, site, slug, cs_id, cs_dir, work, base, items), work, log_path, add)
    if rc == TAMPERED:
        return abandon("abandoned", "an agent modified pipeline policy files (restored); change set discarded")
    if rc == 75:
        return defer("%s during implementation" % LAST_DEFER["why"])

    base_ref = "origin/" + site.get("default_branch", "main")
    last_round = 3
    for round_no in (1, 2, 3):
        ok, why, files = check_diff(cfg, site, work, items, base_ref)
        if not ok:
            if why == "no file changes":
                # an agent that changed nothing judged the fix undoable from the repo; a second try only repeats that
                # (11 wasted runs in Sep 2026: dashboard settings, unanswered decisions, "continue the pass")
                return abandon("abandoned", "implementer made no changes", item_state="owner_action")
            if round_no < last_round and why.startswith(("touched", "net removal", "uncommitted")):
                # the fix is usually right and one file is out of bounds: one round to take that file back out
                blockers = [{"id": "SCOPE", "evidence": why + " (if the previous run was cut off mid-edit, either "
                                                             "finish and commit that work or discard it)",
                             "smallest_fix": "restore every out-of-scope file to origin/%s exactly (git checkout origin/%s -- <file>) "
                                             "and commit that on this branch; keep the in-scope work; if an approved id cannot be "
                                             "resolved without that file, leave it unresolved and say so in implement.json" % (
                                                 site.get("default_branch", "main"), site.get("default_branch", "main"))}]
                rc = claude(cfg, "implement", read_prompt("implement") + "\n" + implement_context(
                    cfg, site, slug, cs_id, cs_dir, work, base, items, blockers), work, log_path, add)
                if rc == TAMPERED:
                    return abandon("abandoned", "an agent modified pipeline policy files (restored); change set discarded")
                if rc == 75:
                    return defer("%s during the scope fix round" % LAST_DEFER["why"])
                continue
            return abandon("abandoned", "diff check: " + why)
        ok, why = run_build(cfg, site, work, log_path)
        if not ok:
            if round_no < last_round:
                blockers = [{"id": "BUILD", "evidence": why, "smallest_fix": "make the build pass"}]
                rc = claude(cfg, "implement", read_prompt("implement") + "\n" + implement_context(
                    cfg, site, slug, cs_id, cs_dir, work, base, items, blockers), work, log_path, add)
                if rc == TAMPERED:
                    return abandon("abandoned", "an agent modified pipeline policy files (restored); change set discarded")
                if rc == 75:
                    return defer("%s during the build fix round" % LAST_DEFER["why"])
                continue
            return abandon("abandoned", "build failed after fix round: " + why)
        cs["state"], cs["files_changed"] = "gating", len(files)
        cs["large_change"] = len(files) > cfg["implement"]["large_change_files"]
        save_cs(slug, cs)
        suffix = "" if round_no == 1 else "-%d" % round_no
        for stale in (os.path.join(cs_dir, "gate%s.json" % suffix),):
            if os.path.exists(stale):
                os.remove(stale)
        reviewed = git(work, "rev-parse", "HEAD")
        rc = claude(cfg, "gate", read_prompt("gate") + "\n" + gate_context(
            cfg, site, slug, cs_id, cs_dir, work, base, items, suffix), work, log_path, add)
        gate = read_json(os.path.join(cs_dir, "gate%s.json" % suffix))
        if rc == TAMPERED:
            return abandon("abandoned", "an agent modified pipeline policy files (restored); change set discarded")
        if rc == 75 and not gate:
            return defer("%s during the gate" % LAST_DEFER["why"])
        rc2, dirty = git(work, "status", "--porcelain", "--untracked-files=no", check=False)
        if git(work, "rev-parse", "HEAD") != reviewed or dirty.strip():
            return abandon("abandoned", "the gate run changed the branch; refusing to ship what was not reviewed")
        if not gate or "verdict" not in gate:
            return abandon("abandoned", "gate produced no verdict (rc=%s)" % rc)
        # auto-policy items are capped by affected count, so in a mixed set the sweep is the owner-named item
        by = [str(i.get("approved_by", "")) for i in items]
        owner_named = (any(a.startswith(OWNER_APPROVERS) for a in by)
                       and all(a.startswith(OWNER_APPROVERS) or a == "auto-policy" for a in by))
        mergeable = gate_mergeable(gate, cs["large_change"], owner_named)
        cs["gate"] = {"round": round_no, "verdict": gate.get("verdict"), "merge_ok": gate.get("merge_ok")}
        save_cs(slug, cs)
        if suffix:
            shutil.copy(os.path.join(cs_dir, "gate%s.json" % suffix), os.path.join(cs_dir, "gate.json"))
        if mergeable:
            break
        if round_no == last_round:
            return abandon("abandoned", "gate did not clear: %s" % json.dumps(gate.get("blockers"))[:400])
        rc = claude(cfg, "implement", read_prompt("implement") + "\n" + implement_context(
            cfg, site, slug, cs_id, cs_dir, work, base, items,
            (gate.get("blockers") or []) + [w for w in gate.get("warnings") or [] if not isinstance(w, dict) or w.get("blocking") is not False]),
            work, log_path, add)
        if rc == TAMPERED:
            return abandon("abandoned", "an agent modified pipeline policy files (restored); change set discarded")
        if rc == 75:
            return defer("%s during the gate fix round" % LAST_DEFER["why"])
    impl = read_json(os.path.join(cs_dir, "implement.json"), {}) or {}
    if not isinstance(impl.get("items"), list):
        return abandon("abandoned", "implementer wrote no implement.json; cannot tell which ids were done")
    done_ids = [r.get("id") for r in impl["items"] if isinstance(r, dict) and r.get("result") in ("done", "partial")]
    if not done_ids:
        return abandon("abandoned", "implement.json reports every id skipped")
    skipped = [i for i in ids if i not in done_ids]

    # last look before main moves: the owner may have rejected an item, a blackout may have begun,
    # someone may have deployed unpushed work
    cur = load_backlog(slug)["items"]
    moved = [i for i in ids if cur.get(i, {}).get("state") != "in_progress" or cur.get(i, {}).get("changeset") != cs_id]
    if moved:
        return abandon("abandoned", "scope changed during the run (%s); nothing pushed" % ", ".join(moved))
    if blackout_active(site, now()):
        return defer("a deploy blackout began during the run")
    blocked = preflight(site, work)
    if blocked:
        return defer("preflight at push time: " + "; ".join(blocked))

    def recheck():
        ok, why, _ = check_diff(cfg, site, work, items, base_ref)
        return ok, why

    cs["state"] = "deploying"
    save_cs(slug, cs)
    ok, info = push_and_deploy(cfg, site, work, log_path, recheck=recheck)
    cs["pushed_at"] = info.get("pushed_at")
    cs["commits"] = info.get("commits", []) if cs["pushed_at"] else []
    cs["deploy"] = {k: v for k, v in info.items() if k != "commits"}
    save_cs(slug, cs)
    if not cs["pushed_at"]:
        return abandon("abandoned", "not merged (%s): %s" % (info.get("stage"), str(info.get("detail"))[:300]))
    if not ok and info.get("stage") == "deploy-unknown":
        lark("SEO visibility: %s change set %s is pushed but Vercel never confirmed the deploy (%s). Not reverting; "
             "the 7-day check will look. Details: %s" % (slug, cs_id, json.dumps(info.get("git_deploy"))[:200], cs_dir))
        mark_shipped(cfg, slug, cs, ids, {}, skipped, "deploy unconfirmed")
        return 0, {"note": "pushed, deploy unconfirmed", "changeset": cs_id, "run_dir": cs_dir}
    if not ok:
        # pushed but the deploy failed: production still serves the old build; take the commits back out of main
        rok, rinfo = revert_changeset(cfg, site, slug, cs, "deploy failed: %s" % json.dumps(info)[:300], log_path)
        lark("SEO visibility: %s change set %s was pushed but its deploy failed (%s). Revert %s. Log: %s" % (
            slug, cs_id, info.get("stage"), "pushed" if rok else "FAILED, needs a human", log_path))
        return abandon("reverted" if rok else "deploy_failed", "deploy failed; revert ok=%s %s" % (rok, rinfo))

    # immediate live validation (Prompt 9)
    cs["state"] = "validating"
    save_cs(slug, cs)
    time.sleep(90)  # CDN propagation
    vwork, _ = prepare_clone(site, slug)
    rc = claude(cfg, "validate", read_prompt("validate") + "\n" + validation_context(
        cfg, site, slug, cs, cs_dir, "immediate", vwork), vwork, log_path, add)
    v = read_json(os.path.join(cs_dir, "validate-immediate.json"), {}) or {}
    if "verdict" not in v:
        lark("SEO visibility: %s change set %s is LIVE but its immediate validation produced no verdict (rc=%s). "
             "Nothing was reverted; the 7-day check will look. Details: %s" % (slug, cs_id, rc, cs_dir))
    statuses = {r.get("id"): r.get("status") for r in v.get("items", []) if isinstance(r, dict)}
    regressed = v.get("revert_recommended") is True or str(v.get("verdict")) == "regressed"
    cs["validation"]["immediate"] = {"verdict": v.get("verdict") or ("unverified rc=%s" % rc), "at": iso()}
    if regressed:
        rok, rinfo = revert_changeset(cfg, site, slug, cs, v.get("revert_reason") or "live regression", log_path)
        cs["state"] = "reverted" if rok else "revert_failed"
        cs["notes"].append("reverted after immediate validation: %s" % (v.get("revert_reason") or "")[:300])
        save_cs(slug, cs)
        blk = load_backlog(slug)
        for i in ids:
            it = blk["items"].get(i)
            if it and it.get("state") == "in_progress":
                it.update({"state": "blocked", "blocked_reason": "live regression, reverted: %s" % (v.get("revert_reason") or "")[:300]})
        save_backlog(slug, blk)
        lark("SEO visibility: %s change set %s caused a live regression and was %s. Reason: %s. Details: %s" % (
            slug, cs_id, "reverted" if rok else "NOT reverted (revert failed, needs a human)",
            (v.get("revert_reason") or "")[:300], cs_dir))
        return 0, {"note": "shipped then reverted", "changeset": cs_id, "run_dir": cs_dir}
    mark_shipped(cfg, slug, cs, ids, statuses, skipped)
    return 0, {"note": "shipped %d item(s): %s" % (len(ids) - len(skipped), ", ".join(i for i in ids if i not in skipped)),
               "changeset": cs_id, "run_dir": cs_dir}


def run_validation(cfg, site, slug, cs_id, phase):
    cs = (read_json_strict(sp(slug)["changes"], {}) or {}).get(cs_id)
    if not cs:
        return 2, {"note": "unknown changeset"}
    cs_dir = os.path.join(sp(slug)["cs"], cs_id)
    work, _ = prepare_clone(site, slug)
    rc = claude(cfg, "validate", read_prompt("validate") + "\n" + validation_context(
        cfg, site, slug, cs, cs_dir, phase, work), work, os.path.join(cs_dir, "pipeline.log"),
        [cs_dir, "/private/tmp"])
    if rc == 75:
        return 75, {"note": "deferred: " + LAST_DEFER["why"]}
    if rc == TAMPERED:
        return 1, {"note": "validation discarded: the agent modified pipeline policy files (restored)", "run_dir": cs_dir}
    v = read_json(os.path.join(cs_dir, "validate-%s.json" % phase))
    if not v or "verdict" not in v:
        return 1, {"note": "validation produced no verdict (rc=%s)" % rc, "run_dir": cs_dir}
    cs.setdefault("validation", {}).setdefault(phase, {}).update({"verdict": v["verdict"], "at": iso()})
    save_cs(slug, cs)
    blk = load_backlog(slug)
    for r in v.get("items", []):
        it = blk["items"].get(r.get("id"))
        if not it:
            continue
        it["live_status"] = r.get("status")
        if phase == "d28" and r.get("status") == "verified_fixed" and it.get("state") == "shipped":
            it["state"] = "validated"
    save_backlog(slug, blk)
    if v["verdict"] in ("regressed", "fail") or v.get("revert_recommended"):
        lark("SEO visibility: %s change set %s %s-day check says %s. Not auto-reverted at this stage (cause is "
             "not provable this late); needs a look. Details: %s/validate-%s.md" % (
                 slug, cs_id, phase[1:], v["verdict"], cs_dir, phase))
    return 0, {"note": "%s %s" % (phase, v["verdict"]), "run_dir": cs_dir}


# ---------------------------------------------------------------- owner commands

def find_item(ident):
    for slug in site_slugs():
        bl = load_backlog(slug)
        if ident in bl["items"]:
            return slug, bl, "items"
        if ident in bl["decisions"]:
            return slug, bl, "decisions"
    return None, None, None


def cmd_owner(action, ident, note):
    slug, bl, kind = find_item(ident)
    if not slug:
        print("unknown id %s" % ident)
        return 1
    fh = site_lock(slug, block=True)   # a run may be reading this backlog right now
    try:
        return _cmd_owner(action, ident, note, slug, kind)
    finally:
        release(fh)


def _cmd_owner(action, ident, note, slug, kind):
    bl = load_backlog(slug)
    d0 = today().isoformat()
    if kind == "decisions":
        dec = bl["decisions"][ident]
        answer = note or action
        yes = re.match(r"^\s*(yes|approve[d]?|do it|go ahead|ship it|ok|okay|option\b|proceed)", answer or "", re.I)
        dec.update({"state": "decided", "answer": answer, "decided_at": d0,
                    "approved": action == "approve" or bool(action == "decide" and yes)})
    else:
        it = bl["items"][ident]
        if action == "approve":
            if it.get("change_class") in OWNER_ACTION_CLASSES or it.get("surface") in ("external", "strategic"):
                it.update({"state": "owner_action", "owner_note": note, "decided_at": d0})
                print("%s is an outside-the-repo action; mark it with `done` once you have done it." % ident)
            else:
                it.update({"state": "approved", "approved_by": "owner (Leo) %s" % d0, "approved_at": d0,
                           "owner_note": note, "impl_attempts": 0, "decided_at": d0})
        elif action == "reject":
            it.update({"state": "rejected", "owner_note": note, "decided_at": d0})
        elif action == "done":
            it.update({"state": "fixed_observed", "owner_note": note or "done by Leo", "decided_at": d0})
    save_backlog(slug, bl)
    print("%s %s: %s" % (slug, ident, action))
    write_status()
    return 0


# ---------------------------------------------------------------- status and digest

def next_audits(cfg, slug, st, horizon=40):
    out, seen = [], set()
    base = st["baselines"].get(slug)
    for i in range(horizon):
        d = today() + dt.timedelta(days=i)
        for t, period, sched in audit_slots(cfg, slug, d):
            if sched != d or t in seen:
                continue
            if base and t in SPECIALISTS and sched < dt.date.fromisoformat(base["date"]) + dt.timedelta(days=cfg["specialist_min_days_after_baseline"]):
                continue
            if base and t == "pulse" and sched <= dt.date.fromisoformat(base["date"]):
                continue
            if st["jobs"].get("%s|%s|%s" % (slug, t, period), {}).get("status") in ("done", "skipped"):
                continue
            seen.add(t)
            out.append("%s %s" % (t, d.strftime("%a %d %b")))
    return out


def owner_queue():
    rows = []
    for slug in site_slugs():
        bl = load_backlog(slug)
        for i in sorted(bl["items"].values(), key=lambda x: (SEVERITY_RANK.get(x.get("severity"), 9), x["id"])):
            if i.get("state") in ("owner_pending", "owner_action"):
                rows.append((slug, i["id"], i.get("severity"), i.get("change_class"), i.get("title"),
                             i.get("state"), (i.get("action") or "")[:160]))
        for d in bl["decisions"].values():
            if d.get("state") == "pending":
                rows.append((slug, d["id"], "-", "decision", d.get("question"), "decision",
                             "recommend: %s" % (d.get("recommendation") or "")[:160]))
    return rows


def write_status():
    try:
        cfg, st = load_config(), read_state()
        L = ["# SEO visibility status", "", "Generated %s. Schedule and rules: %s/README.md" % (iso(), ROOT), ""]
        for slug in site_slugs():
            site = load_site(slug) or {}
            bl = load_backlog(slug)
            counts = {}
            for i in bl["items"].values():
                counts[i.get("state")] = counts.get(i.get("state"), 0) + 1
            v = bl.get("verdict") or {}
            L += ["## %s (%s)" % (slug, site.get("production_url")),
                  "- Last verdict: %s %s: %s" % (v.get("date", "-"), v.get("type", ""), v.get("line") or v.get("verdict") or "no run yet"),
                  "- Backlog: %s" % (", ".join("%s %d" % kv for kv in sorted(counts.items(), key=lambda kv: str(kv[0]))) or "empty"),
                  "- Next: %s" % ("; ".join(next_audits(cfg, slug, st)[:5]) or "-"),
                  "- Implementation: %s" % ("on" if implement_allowed(cfg, site)[0] else "off (%s)" % implement_allowed(cfg, site)[1]),
                  "- Change sets: %s" % ("; ".join(changesets_summary(slug)[-3:]) or "none"), ""]
        L += ["## Running", ""] + ["- %s since %s" % (k, v.get("started")) for k, v in st["running"].items()] + [""]
        fails = [(k, v) for k, v in st["jobs"].items() if v.get("status") == "failed"]
        L += ["## Failed jobs (retry up to %d times within their period)" % cfg["max_attempts"], ""]
        L += ["- %s attempts=%s %s" % (k, v.get("attempts"), (v.get("note") or "")[:200]) for k, v in fails[-15:]] or ["- none"]
        q = owner_queue()
        L += ["", "## Needs Leo (%d)" % len(q), "", "Approve or reject by telling Claude, or `seo-visibility approve|reject <ID>`; outside-the-repo actions: `seo-visibility done <ID>`.", ""]
        L += ["- %s %s [%s %s] %s (%s) %s" % r for r in q] or ["- nothing"]
        with open(os.path.join(ROOT, "STATUS.md"), "w") as f:
            f.write("\n".join(L).encode("ascii", "replace").decode("ascii") + "\n")
    except Exception:
        log("write_status failed: " + traceback.format_exc()[-800:])


SITE_REPORT_MAX_ASKS = 5
JOB_LABELS = {"baseline": "full baseline audit", "pulse": "weekly check", "technical": "technical audit",
              "content": "content audit", "backlinks": "backlinks review", "ai": "AI search visibility check",
              "quarterly": "quarterly review"}
FIXED_STATES = ("shipped", "fixed_observed")


def site_webhook(cfg, slug):
    return (cfg.get("site_lark_webhooks") or {}).get(slug)


def site_name(slug):
    site = load_site(slug) or {}
    return site.get("name") or (site.get("production_url") or slug).split("//")[-1].strip("/")


def site_owner_rows(slug):
    """What waits on Leo for one site: P0/P1 items, then decisions, then the rest."""
    bl = load_backlog(slug)
    rows = []
    for i in bl["items"].values():
        if i.get("state") in ("owner_pending", "owner_action"):
            rank = SEVERITY_RANK.get(i.get("severity"), 9)
            rows.append({"id": i["id"], "kind": "item", "state": i.get("state"), "change_class": i.get("change_class"),
                         "text": i.get("title") or i["id"], "need": i.get("action") or "",
                         "order": (0 if rank <= 1 else 2, rank, i["id"])})
    for d in bl["decisions"].values():
        if d.get("state") == "pending":
            rec = d.get("recommendation") or ""
            rows.append({"id": d["id"], "kind": "decision", "state": "decision", "change_class": "decision",
                         "text": d.get("question") or d["id"], "need": ("Recommended: " + rec) if rec else "",
                         "order": (1, 0, d["id"])})
    return sorted(rows, key=lambda r: r["order"])


def unblock_prompt(name, row):
    """One line Leo can paste into any Claude terminal; it names the pipeline so a fresh session can act."""
    ref = "SEO pipeline (~/.local/share/seo-visibility) %s %s for %s" % (
        "decision" if row["kind"] == "decision" else "item", row["id"], name)
    if row["kind"] == "decision":
        return "%s: my answer is ____. Record it with seo-visibility decide and carry it through." % ref
    if row["state"] == "owner_pending":
        return "%s: approve it. (To decline instead: reject it because ____.)" % ref
    if row["change_class"] in OWNER_ACTION_CLASSES:
        return "%s: I have done this. Check that it worked, then run seo-visibility done %s." % (ref, row["id"])
    return "%s: here is my decision or the missing fact: ____. Make the change, check it live, and record it." % ref


def _clip(text, n):
    text = re.sub(r"\s+", " ", text or "").strip()
    return text if len(text) <= n else text[:n - 3].rstrip() + "..."


def render_asks(name, rows, limit=SITE_REPORT_MAX_ASKS):
    out = []
    for n, r in enumerate(rows[:limit], 1):
        out.append("%d. %s (%s)" % (n, _clip(r["text"], 320), r["id"]))
        if r["need"]:
            out.append("   What is needed: %s" % _clip(r["need"], 220))
        out.append("   Paste into Claude: %s" % unblock_prompt(name, r))
    if len(rows) > limit:
        out.append("+ %d more waiting. To see them all, ask Claude: Which SEO items for %s are waiting on me?" % (len(rows) - limit, name))
    return out


def fixed_since(slug, since_iso):
    changes = read_json(sp(slug)["changes"], {}) or {}
    out = []
    for i in load_backlog(slug)["items"].values():
        if i.get("state") not in FIXED_STATES:
            continue
        cs = changes.get(i.get("shipped_in") or "") or {}
        when = cs.get("pushed_at") or i.get("decided_at") or ""
        if when and when[:10] >= since_iso[:10]:
            out.append(i)
    return sorted(out, key=lambda i: (SEVERITY_RANK.get(i.get("severity"), 9), i["id"]))


def verdict_is_current(slug, v, since):
    """Show an audit verdict only if it ran this window and nothing was fixed after it (else it describes fixed problems)."""
    if not v or v.get("date", "") < since[:10]:
        return False
    changes = read_json(sp(slug)["changes"], {}) or {}
    fixes = [((changes.get(i.get("shipped_in") or "") or {}).get("pushed_at") or i.get("decided_at") or "")[:10]
             for i in load_backlog(slug)["items"].values() if i.get("state") in FIXED_STATES]
    return v.get("date", "") >= max(fixes or [""])


def site_report(cfg, st, slug, days=7):
    name = site_name(slug)
    since = (now() - dt.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S")
    bl = load_backlog(slug)
    v = bl.get("verdict") or {}
    L = ["%s: SEO update, %s" % (name, today().strftime("%a %d %b"))]
    fixed = fixed_since(slug, since)
    L += ["", "Fixed and live (%d)" % len(fixed) if fixed else "No fixes went live this week."]
    L += ["- %s (%s)" % (_clip(i.get("title"), 160), i["id"]) for i in fixed[:10]]
    if len(fixed) > 10:
        L.append("- and %d more" % (len(fixed) - 10))
    runs = sorted({k.split("|")[1] for k, j in st["jobs"].items() if k.startswith(slug + "|")
                   and j.get("status") == "done" and j.get("finished", "") >= since and k.split("|")[1] in JOB_LABELS})
    L += ["", "Checks run this week: %s" % (", ".join(JOB_LABELS[r] for r in runs) if runs else "none")]
    if verdict_is_current(slug, v, since):
        L.append("Latest audit (%s): %s" % (v.get("date", "-"), _clip(v.get("line") or v.get("verdict"), 300)))
    rows = site_owner_rows(slug)
    L += ["", "Needs Leo (%d)" % len(rows) if rows else "Nothing needs Leo right now."]
    L += render_asks(name, rows)
    nxt = []
    for entry in next_audits(cfg, slug, st)[:3]:
        t, _, when = entry.partition(" ")
        nxt.append("%s %s" % (JOB_LABELS.get(t, t), when))
    if nxt:
        L += ["", "Next: %s" % "; ".join(nxt)]
    return "\n".join(L)


def notify_site_queues(cfg):
    """Each tick: tell a site's group about owner items it has not heard about yet. The first
    run for a site only records what is already waiting, so switching this on is silent."""
    for slug in site_slugs():
        hook = site_webhook(cfg, slug)
        if not hook:
            continue
        path = os.path.join(STATE_DIR, "site-notified-%s.json" % slug)
        rows = site_owner_rows(slug)
        ids = sorted(r["id"] for r in rows)
        if not os.path.exists(path):
            write_json(path, {"ids": ids, "seeded": iso()})
            continue
        known = set((read_json(path, {}) or {}).get("ids") or [])
        new = [r for r in rows if r["id"] not in known]
        if new:
            name = site_name(slug)
            head = "%s: %s new SEO item%s need%s Leo" % (name, len(new), "" if len(new) == 1 else "s",
                                                        "s" if len(new) == 1 else "")
            if not send_site(cfg, hook, new_items_card(name, new), "\n".join([head, ""] + render_asks(name, new, limit=10))):
                continue   # retry next tick
        write_json(path, {"ids": ids, "updated": iso()})


MD_ESCAPE = {"<": "&#60;", ">": "&#62;", "*": "&#42;", "_": "&#95;", "~": "&#126;", "[": "&#91;",
             "]": "&#93;", "`": "&#96;", "#": "&#35;", "&": "&#38;"}


def md(text):
    """Escape dynamic text for Lark card markdown, so '<slug>' or '____' show as written."""
    return "".join(MD_ESCAPE.get(ch, ch) for ch in (text or ""))


def _card(title, subtitle, waiting, elements):
    header = {"title": {"tag": "plain_text", "content": title},
              "subtitle": {"tag": "plain_text", "content": subtitle},
              "template": "yellow" if waiting else "green",
              "icon": {"tag": "standard_icon", "token": "todo_colorful" if waiting else "lark-logo_colorful"},
              "text_tag_list": [{"tag": "text_tag", "color": "yellow" if waiting else "green", "text": {
                  "tag": "plain_text", "content": ("%d need%s Leo" % (waiting, "s" if waiting == 1 else "")) if waiting else "Nothing needs Leo"}}]}
    return {"schema": "2.0",
            "config": {"summary": {"content": subtitle}},
            "header": header,
            "body": {"direction": "vertical", "padding": "12px 12px 20px 12px", "vertical_spacing": "12px",
                     "elements": elements}}


def _block(color, elements):
    return {"tag": "interactive_container", "width": "fill", "has_border": True, "border_color": color + "-100",
            "corner_radius": "8px", "background_style": color + "-50", "padding": "12px 12px 12px 12px",
            "vertical_spacing": "4px", "elements": elements}


def card_asks(name, rows, limit=SITE_REPORT_MAX_ASKS):
    """One highlighted block per item waiting on Leo: bold ask, grey detail, bold paste-into-Claude line."""
    out = []
    for n, r in enumerate(rows[:limit], 1):
        els = [{"tag": "markdown", "content": "**%d. %s**\n<font color='grey'>%s</font>" % (n, md(_clip(r["text"], 320)), md(r["id"]))}]
        if r["need"]:
            els.append({"tag": "markdown", "text_size": "notation", "content": "<font color='grey'>What is needed: %s</font>" % md(_clip(r["need"], 260))})
        els.append({"tag": "markdown", "content": "**Paste into Claude:**\n**%s**" % md(unblock_prompt(name, r))})
        out.append(_block("yellow", els))
    if len(rows) > limit:
        out.append({"tag": "markdown", "text_size": "notation", "content": "+ %d more waiting. To see them all, paste into Claude: **%s**" % (
            len(rows) - limit, md("Which SEO items for %s are waiting on me?" % name))})
    return out


def site_report_card(cfg, st, slug, days=7):
    name = site_name(slug)
    since = (now() - dt.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S")
    rows = site_owner_rows(slug)
    els = []
    if rows:
        els.append({"tag": "markdown", "content": "**Needs Leo (%d)**" % len(rows)})
        els += card_asks(name, rows)
    fixed = fixed_since(slug, since)
    if fixed:
        lines = ["- %s" % md(_clip(i.get("title"), 160)) for i in fixed[:10]]
        if len(fixed) > 10:
            lines.append("- and %d more" % (len(fixed) - 10))
        els.append(_block("green", [{"tag": "markdown", "content": "**Fixed and live (%d)**" % len(fixed)},
                                    {"tag": "markdown", "content": "\n".join(lines)}]))
    else:
        els.append({"tag": "markdown", "content": "<font color='grey'>No fixes went live this week.</font>"})
    st_jobs = st["jobs"]
    runs = sorted({k.split("|")[1] for k, j in st_jobs.items() if k.startswith(slug + "|")
                   and j.get("status") == "done" and j.get("finished", "") >= since and k.split("|")[1] in JOB_LABELS})
    foot = ["Checks this week: %s" % (", ".join(JOB_LABELS[r] for r in runs) if runs else "none")]
    v = load_backlog(slug).get("verdict") or {}
    if verdict_is_current(slug, v, since):
        foot.append("Latest audit (%s): %s" % (v.get("date"), _clip(v.get("line") or v.get("verdict"), 300)))
    nxt = []
    for entry in next_audits(cfg, slug, st)[:3]:
        t, _, when = entry.partition(" ")
        nxt.append("%s %s" % (JOB_LABELS.get(t, t), when))
    if nxt:
        foot.append("Next: %s" % "; ".join(nxt))
    els.append({"tag": "markdown", "text_size": "notation", "content": "<font color='grey'>%s</font>" % md("\n".join(foot)).replace("\n", "<br>")})
    subtitle = "Weekly update, %s" % today().strftime("%a %d %b")
    return _card("%s: SEO update" % name, subtitle, len(rows), els)


def new_items_card(name, rows):
    subtitle = "%d new item%s since the last update" % (len(rows), "" if len(rows) == 1 else "s")
    return _card("%s: SEO needs Leo" % name, subtitle, len(rows), card_asks(name, rows, limit=10))


def send_site(cfg, hook, card, text):
    """Card first; plain text if Lark refuses the card, so a format problem never loses the update."""
    return lark_card(card, cfg, webhook=hook) or lark(text, cfg, webhook=hook)


def cmd_digest(send=False):
    cfg, st = load_config(), read_state()
    week_ago = (now() - dt.timedelta(days=7)).strftime("%Y-%m-%dT%H:%M:%S")
    L = ["SEO + AI visibility weekly, %s" % today().isoformat()]
    ok = True
    for slug in site_slugs():
        hook = site_webhook(cfg, slug)
        if not hook:
            continue
        text = site_report(cfg, st, slug)
        if send:
            ok = send_site(cfg, hook, site_report_card(cfg, st, slug), text) and ok
        else:
            print(text + "\n\n---\n")
    rest = [x for x in site_slugs() if not site_webhook(cfg, x)]
    for slug in rest:
        site = load_site(slug) or {}
        bl = load_backlog(slug)
        v = bl.get("verdict") or {}
        runs = [k.split("|")[1] for k, j in st["jobs"].items() if k.startswith(slug + "|")
                and j.get("status") == "done" and j.get("finished", "") >= week_ago]
        shipped = [c for c in (read_json(sp(slug)["changes"], {}) or {}).values() if c.get("created", "") >= week_ago]
        open_hi = [i for i in bl["items"].values() if i.get("severity") in ("P0", "P1")
                   and i.get("state") in ("proposed", "approved", "owner_pending", "owner_action", "blocked", "in_progress")]
        L.append("")
        L.append("%s: %s" % (site.get("production_url", slug), v.get("line") or v.get("verdict") or "no audit yet"))
        L.append("  ran: %s | open P0/P1: %d | change sets: %s" % (
            ", ".join(sorted(runs)) or "nothing", len(open_hi),
            ", ".join("%s %s (%d items)" % (c["id"].split("-", 1)[1], c.get("state"), len(c.get("items", []))) for c in shipped) or "none"))
    q = [r for r in owner_queue() if r[0] in rest]
    L += ["", "Needs you (%d):" % len(q)]
    for r in q[:12]:
        L.append("- %s [%s %s] %s -> %s" % (r[1], r[2], r[3], (r[4] or "")[:110], r[6][:120]))
    if len(q) > 12:
        L.append("- ... %d more in STATUS.md" % (len(q) - 12))
    if not q:
        L.append("- nothing")
    fails = [k for k, j in st["jobs"].items() if j.get("status") == "failed" and j.get("last_attempt", "") >= week_ago]
    L += ["", "Pipeline: %d failed job(s) this week%s" % (len(fails), (": " + ", ".join(fails[:6])) if fails else ""),
          "Approve/reject: tell Claude 'approve <ID>' or run seo-visibility approve <ID>. Full status: %s/STATUS.md" % ROOT]
    text = "\n".join(L)
    write_status()
    if not rest and not fails:
        return 0 if ok else 1        # every site reports to its own group and nothing failed
    if send:
        return 0 if (lark(text, cfg) and ok) else 1
    print(text)
    return 0


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    opt = {}
    pos = []
    i = 0
    while i < len(rest):
        if rest[i].startswith("--"):
            k = rest[i][2:]
            if i + 1 < len(rest) and not rest[i + 1].startswith("--") and k in ("period", "days"):
                opt[k] = rest[i + 1]
                i += 2
                continue
            opt[k] = True
        else:
            pos.append(rest[i])
        i += 1
    if cmd == "dispatch":
        return cmd_dispatch(dry_run=bool(opt.get("dry-run")))
    if cmd == "run" and len(pos) >= 2:
        return cmd_run(pos[0], pos[1], opt.get("period"))
    if cmd == "calendar":
        return cmd_calendar(int(opt.get("days", 42))) or 0
    if cmd == "status":
        write_status()
        print(open(os.path.join(ROOT, "STATUS.md")).read())
        return 0
    if cmd in ("approve", "reject", "done", "decide") and pos:
        return cmd_owner(cmd, pos[0], " ".join(pos[1:]))
    if cmd == "auto-decide":
        return cmd_auto_decide(pos or site_slugs(), dry_run=bool(opt.get("dry-run")))
    if cmd == "digest":
        return cmd_digest(send=bool(opt.get("send")))
    if cmd == "report" and pos:
        cfg = load_config()
        text = site_report(cfg, read_state(), pos[0], days=int(opt.get("days", 7)))
        card = site_report_card(cfg, read_state(), pos[0], days=int(opt.get("days", 7)))
        if opt.get("send"):
            hook = site_webhook(cfg, pos[0])
            if not hook:
                print("no site_lark_webhooks entry for %s" % pos[0])
                return 1
            return 0 if send_site(cfg, hook, card, text) else 1
        print(json.dumps(card, indent=2) if opt.get("json") else text)
        return 0
    if cmd == "sync-prompts":
        return cmd_sync_prompts()
    if cmd == "operator-edit":
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, "operator-edit.stamp"), "w") as f:
            f.write(iso())
        print("operator edit window opened: changes to policy files or code made now will not trip the tamper check "
              "for runs already in flight")
        return 0
    if cmd == "reclone" and pos:
        site = load_site(pos[0])
        work = os.path.join(WORK, pos[0])
        if os.path.exists(work):
            shutil.rmtree(work)
        w, sha = prepare_clone(site, pos[0])
        vsrc = os.path.join(site["repo_path"], ".vercel", "project.json")
        if os.path.exists(vsrc):
            os.makedirs(os.path.join(w, ".vercel"), exist_ok=True)
            shutil.copy(vsrc, os.path.join(w, ".vercel", "project.json"))
        print("%s clone at %s (%s)" % (pos[0], w, sha[:9]))
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
