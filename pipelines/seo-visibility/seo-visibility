    with open(os.path.join(LOGS, "seo-visibility.log"), "a") as f:
        f.write("[%s] %s\n" % (iso(), msg))


def read_json(path, default=None):
    """Lenient read for optional files (reports, gate/validation outputs, site.json)."""
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


class CorruptFile(Exception):
    pass


def read_json_strict(path, default):
    """For ledgers the pipeline rewrites (backlog, changes, state). A missing file is empty; a corrupt one
    stops the job instead of being silently replaced, which would resurrect rejected items."""
    if not os.path.exists(path):
        return default
    try:
        with open(path) as f:
            return json.load(f)
    except ValueError as e:
        raise CorruptFile("%s is not valid JSON (%s); fix or restore it, nothing was overwritten" % (path, e))


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=False)
        f.write("\n")
    os.replace(tmp, path)


def deep_merge(base, over):
    out = copy.deepcopy(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def load_config():
    """An unreadable config never turns implementation on: it falls back to defaults with implement off."""
    try:
        with open(CONFIG_PATH) as f:
            user = json.load(f)
    except OSError:
        user = {}
    except ValueError as e:
        log("config.json is invalid, implementation forced off: %s" % e)
        user = {"implement": {"enabled": False}, "_invalid": str(e)}
    if not isinstance(user, dict):
        user = {"implement": {"enabled": False}, "_invalid": "config.json is not a JSON object"}
    return deep_merge(DEFAULT_CONFIG, user)


def sh(args, cwd=None, timeout=None, check=False, capture=True, env=None):
    e = dict(os.environ)
    e["PATH"] = PATH_ENV
    if env:
        e.update(env)
    p = subprocess.run(args, cwd=cwd, timeout=timeout, env=e, stdin=subprocess.DEVNULL,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.STDOUT if capture else None)
    out = p.stdout.decode("utf-8", "replace") if capture and p.stdout else ""
    if check and p.returncode != 0:
        raise RuntimeError("%s failed rc=%s: %s" % (" ".join(args[:4]), p.returncode, out[-800:]))
    return p.returncode, out


def git(cwd, *args, check=True, timeout=600):
    rc, out = sh(["git"] + list(args), cwd=cwd, timeout=timeout, check=check)
    return out.strip() if check else (rc, out.strip())


