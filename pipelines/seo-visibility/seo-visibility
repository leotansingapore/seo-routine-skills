NETWORK_RE = re.compile(r"Could not resolve host|Failed to connect to|Couldn't connect to server|Network is unreachable|"
                        r"Temporary failure in name resolution|nodename nor servname provided|"
                        r"(Connection|Operation) timed out", re.I)


def network_up(host="github.com"):
    """False when the Mac cannot reach GitHub (asleep, offline, DNS down): every job would fail at its fetch."""
    import socket
    old = socket.getdefaulttimeout()
    try:
        socket.setdefaulttimeout(5)
        socket.getaddrinfo(host, 443)
        return True
    except OSError:
        return False
    finally:
        socket.setdefaulttimeout(old)


GIT_AUTH_RE = re.compile(r"could not read Username|Authentication failed|terminal prompts disabled|"
                         r"Permission denied \(publickey\)|invalid credentials|401 Unauthorized", re.I)
TRANSIENT_RE = re.compile(r"API Error|can't reach the API server|ENOTFOUND|ECONNRESET|ETIMEDOUT|fetch failed|"
                          r"502 Bad Gateway|503 Service|Service Unavailable|overloaded_error", re.I)
LIMIT_RE = re.compile(r"hit your (session|usage|weekly) limit|usage limit reached|session limit reached|"
                      r"you have reached your (usage|session|weekly) limit", re.I)
RESET_RE = re.compile(r"resets\s+(?:([A-Za-z]{3,9})\s+(\d{1,2}),?\s*)?(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)", re.I)
MONTHS = {m: i + 1 for i, m in enumerate(["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"])}


def account_fp():
    """Same fingerprint claude-resilient.sh uses: changes when Leo switches the CLI to another account."""
    try:
        out = subprocess.run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20).stdout
        return hashlib.sha1(out.strip()).hexdigest()[:16] if out.strip() else ""
    except Exception:
        return ""


def parse_reset(text, t=None):
    """Reads both shapes Claude prints: 'resets 7:20pm' (session) and 'resets Sep 20 at 3am' (weekly)."""
    t = t or now()
    m = RESET_RE.search(text or "")
    if not m:
        return t + dt.timedelta(minutes=60)
    mon, day, hh, mm, ampm = m.groups()
    hour = int(hh) % 12 + (12 if ampm.lower() == "pm" else 0)
    r = t.replace(hour=hour, minute=int(mm or 0), second=0, microsecond=0)
    if mon and MONTHS.get(mon[:3].lower()):
        month = MONTHS[mon[:3].lower()]
        year = t.year - (1 if month - t.month > 6 else 0) + (1 if t.month - month > 6 else 0)
        try:
            return r.replace(year=year, month=month, day=int(day))
        except ValueError:
            return r
    return r if r > t else r + dt.timedelta(days=1)


def note_limit(text):
    until = parse_reset(text)
    cap = now() + dt.timedelta(days=8)   # a mis-parsed date must not pause every site for months
    if until > cap:
        log("limit reset parsed as %s, capping at %s" % (iso(until), iso(cap)))
        until = cap
    if (until - now()).total_seconds() > 6 * 3600:
        alert_once("limit-long", "SEO visibility: Claude quota is exhausted until %s, so audits and fixes are paused "
                   "until then. Switching the CLI account clears it immediately." % iso(until), every_hours=12)
    write_json(os.path.join(STATE_DIR, "claude-limit.json"),
               {"until": iso(until), "account": account_fp(), "seen": iso(), "text": (text or "").strip()[-200:]})
    log("Claude usage limit: Claude jobs deferred until %s" % iso(until))


