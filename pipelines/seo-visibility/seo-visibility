def load_backlog(slug):
    bl = read_json_strict(sp(slug)["backlog"], {}) or {}
    bl.setdefault("items", {})
    bl.setdefault("decisions", {})
    return bl


def save_backlog(slug, bl):
    write_json(sp(slug)["backlog"], bl)


def validate_findings(data):
    if not isinstance(data, dict) or not isinstance(data.get("findings"), list):
        return "findings missing"
    for f in data["findings"]:
        for k in ("id", "title", "status", "severity", "change_class", "evidence_status", "confidence"):
            if k not in f:
                return "finding %s lacks %s" % (f.get("id", "?"), k)
        if f["severity"] not in SEVERITY_RANK:
            return "bad severity on %s" % f["id"]
    return None


def affected(item):
    try:
        return int(item.get("affected_count") or 0)
    except (TypeError, ValueError):
        return 0


def auto_ok(item, cfg):
    a = cfg["auto_approve"]
    cap = a.get("max_affected_links", 12) if item.get("change_class") == "internal_link_add" else a.get("max_affected", 80)
    return (item.get("change_class") in AUTO_CLASSES and item.get("severity") in a["severities"]
            and str(item.get("evidence_status", "")).lower() in a["evidence_status"]
            and item.get("confidence") in a["confidence"] and item.get("surface") in a["surface"]
            and item.get("risk") in a["risk"] and item.get("status") != "fixed" and affected(item) <= cap)


def classify(item, cfg, bl, protected=()):
    if item.get("state") not in ("proposed", "owner_pending", "owner_action"):
        return
    if item.get("status") == "fixed":
        return
    if item.get("no_op_at"):
        item["state"] = "owner_action"
        return
    ref = item.get("owner_decision_ref")
    if ref and bl["decisions"].get(ref, {}).get("state") == "decided" and bl["decisions"][ref].get("approved"):
        # a decided decision is context, never an approval: "leave as is" was being stored as approved and every
        # finding citing it inherited that (VEPCO-DEC-011 -> VEPCO-TECH-003, caught 2026-09-15 before it shipped)
        item["state"] = "owner_pending"
        item["decision_note"] = "cites decided %s; still needs its own approval" % ref
    elif auto_ok(item, cfg) and any(match_path(str(f).split(" ")[0].strip().lstrip("/"), protected)
                                    for f in item.get("files") or []):
        # retro 2026-W40: auto-policy never satisfies the protected-path guard, so these burned two implement runs
        # each; auto-decide (Jev) or Leo approves them instead, and that approval does cover protected paths
        item["state"] = "owner_pending"
        item["decision_note"] = "auto-class fix that needs a protected file"
    elif auto_ok(item, cfg):
        item.update({"state": "approved", "approved_by": "auto-policy", "approved_at": today().isoformat()})
    elif item.get("severity") in ("P0", "P1", "P2") and item.get("change_class") in OWNER_ACTION_CLASSES:
        item["state"] = "owner_action"
    elif item.get("surface") not in ("repo", "hosting") and item.get("severity") in ("P0", "P1", "P2"):
        # cms, external and strategic work cannot be shipped from a git clone: it would sit "approved" forever
        item["state"] = "owner_action"
    elif (item.get("severity") in ("P0", "P1", "P2") and item.get("change_class") in AUTO_CLASSES
          and str(item.get("evidence_status", "")).lower() == "verified" and item.get("surface") == "repo"):
        item["state"] = "owner_pending"  # bulk, medium-risk or lower-confidence auto-class work: Leo says yes or no
    elif (item.get("severity") in ("P0", "P1", "P2") and item.get("change_class") in OWNER_DECISION_CLASSES
          and str(item.get("evidence_status", "")).lower() in ("verified", "inferred")):
        item["state"] = "owner_pending"
    else:
        item["state"] = "proposed"


POLICY_FIELDS = ("change_class", "severity", "risk", "confidence", "surface", "evidence_status")
OWNER_POLICY_FIELDS = ("change_class", "surface", "risk")
FIELDS = ["title", "status", "evidence_status", "severity", "confidence", "surface", "change_class", "urls",
          "files", "affected_count", "evidence", "action", "validation", "effort", "risk", "owner_decision_ref"]


def merge_backlog(cfg, slug, data, run_dir, jtype):
    protected = (pipe(load_site(slug)).get("protected") or []) + ALWAYS_PROTECTED
    bl = load_backlog(slug)
    d0 = today().isoformat()
    new_p0 = []
    for f in data.get("findings", []):
        fid = str(f.get("id", "")).strip()
        if not fid:
            continue
        item = bl["items"].get(fid)
        fresh = item is None
        if fresh:
            item = {"id": fid, "first_seen": d0, "state": "proposed", "history": []}
        before = {k: item.get(k) for k in POLICY_FIELDS + ("files",)}
        item.update({k: f.get(k) for k in FIELDS if k in f})
        item["evidence_status"] = str(item.get("evidence_status", "")).lower().replace(" ", "_")
        if item.get("state") == "approved" and not fresh:
            # an approval covers what was approved: a re-labelled finding is decided again
            owner = str(item.get("approved_by", "")).startswith("owner")
            keys = OWNER_POLICY_FIELDS if owner else POLICY_FIELDS
            changed = [k for k in keys if k != "files" and item.get(k) != before.get(k)]
            if owner and set(item.get("files") or []) - set(before.get("files") or []):
                changed.append("files")
            if changed:
                item["state"] = "proposed"
                item["reclassified"] = "%s: %s changed after approval by %s" % (d0, ", ".join(changed), item.get("approved_by"))
                item.pop("approved_by", None)
        item["last_seen"], item["last_run"] = d0, run_dir
        item["history"] = (item.get("history") or [])[-19:] + [
            {"date": d0, "run": jtype, "status": f.get("status"), "severity": f.get("severity")}]
        st = item.get("state")
        if f.get("status") == "fixed":
            if st in ("proposed", "approved", "owner_pending", "owner_action", "blocked", "not_fixed"):
                item["state"] = "fixed_observed"
        elif st in ("fixed_observed", "shipped", "validated") and f.get("status") in ("new", "persistent"):
            item["state"] = "proposed"
            item["reopened"] = d0
        classify(item, cfg, bl, protected)
        if item.get("severity") == "P0" and fresh and item["state"] not in ("rejected", "fixed_observed"):
            new_p0.append(item)
        bl["items"][fid] = item
    for d in data.get("owner_decisions", []) or []:
        did = str(d.get("id", "")).strip()
        if not did or bl["decisions"].get(did, {}).get("state") == "decided":
            continue
        cur = bl["decisions"].get(did, {"first_seen": d0})
        cur.update({"id": did, "question": d.get("question"), "options": d.get("options"),
                    "recommendation": d.get("recommendation"), "why": d.get("why"), "state": "pending",
                    "last_seen": d0, "last_run": run_dir})
        bl["decisions"][did] = cur
    bl["data_requests"] = data.get("data_requests") or bl.get("data_requests") or []
    bl["verdict"] = {"type": jtype, "date": d0, "verdict": data.get("verdict"), "line": data.get("verdict_line")}
    save_backlog(slug, bl)
    return new_p0


# Leo 2026-10-02: "allow the thing to decide itself". Pending decisions take the audit's recommendation and
# owner_pending items are approved, unless Jev says only the owner can settle it (a fact only he has, money,
# auth, legal). Those stay with Leo. Missing key or a Jev failure leaves everything pending (the old behaviour).
JEV_URL = "https://api.typesafe.ai/v1/systemone"
JEV_MODEL = "jev-1.13.0"   # pinned, never jev-latest
# Set from a read of all 138 pending rows on 2026-10-02: under 0.3 every call was a sound technical one; 0.3-0.5 was
# mostly owner-only (Vercel secrets, a WhatsApp number, which Ads account is live, prices, subdomain ownership).
OWNER_ONLY_MAX = 0.3
OWNER_ONLY_PATHS = ("package.json", "package-lock.json", "bun.lock", "bun.lockb", "supabase/", ".env")


# auto-decide speaks for Leo (his call, 2026-10-02): its approvals count as his for protected paths and gate sweeps
OWNER_APPROVERS = ("owner", "auto-decide", "fact-finder")


def jev_key():
    key = os.environ.get("TYPESAFE_API_KEY")
    if key:
        return key
    try:   # launchd does not load the shell profile
        m = re.search(r"TYPESAFE_API_KEY=['\"]?([^'\"\s]+)", open(os.path.expanduser("~/.zshenv")).read())
        return m.group(1) if m else None
    except OSError:
        return None


def jev_owner_only(state, key):
    """Probability that only the business owner can settle this. None on failure."""
    q = {"owner_only": {"type": "noul", "instructions": (
        "This is an open question from an automated SEO audit of a business website, with the auditor's "
        "recommended answer. Can it only be settled by the business owner? It can when the answer depends on "
        "a fact only the owner knows (whether named people, testimonials, reviews, credentials or clients are "
        "real or consented; prices, fees, services offered, contact details, legal or contract terms), or "
        "when it spends money, changes logins or access, or makes a legal or compliance commitment. It cannot "
        "when the recommendation is a technical or SEO judgement the evidence already supports, such as "
        "noindexing placeholders, redirects, code splitting, sitemap or metadata changes, or waiting for data."),
        "criteria": {"true": "Acting without the owner risks stating something false or committing the owner.",
                     "false": "The evidence and recommendation are enough to act on."}}}
    body = json.dumps({"model": JEV_MODEL, "state": state, "questions": q}).encode()
    req = urllib.request.Request(JEV_URL, data=body, headers={
        "Authorization": "Bearer %s" % key, "Content-Type": "application/json"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return float(json.load(r)["answers"]["owner_only"]["noul"])
        except Exception as e:
            if attempt < 2:
                time.sleep(2 ** attempt + 1)
                continue
            log("jev owner_only failed: %s" % e)
    return None


# Leo 2026-10-03: "all the seo routine jobs self deciding and self improving". A business fact the owner was asked
# for is settled by the pipeline when public sources independent of the audited site agree on it. Consent (are
# these people/reviews real and willing), secrets, money, prices and preferences stay with Leo.
FACT_MIN_SOURCES = 2


def fact_candidates(bl):
    out = []
    for d in bl["decisions"].values():
        if d.get("state") == "pending":
            out.append({"id": d["id"], "kind": "decision", "question": d.get("question"), "options": d.get("options"),
                        "recommendation": d.get("recommendation")})
    for it in bl["items"].values():
        if it.get("state") in ("owner_pending", "owner_action") and it.get("change_class") in ("business_fact", "external_account"):
            out.append({"id": it["id"], "kind": "item", "title": it.get("title"), "action": it.get("action"),
                        "evidence": str(it.get("evidence"))[:800]})
    return out


def find_facts(cfg, site, slug, run_dir):
    bl = load_backlog(slug)
    d0 = today().isoformat()
    week_ago = (today() - dt.timedelta(days=7)).isoformat()
    tried = bl.get("facts_tried") or {}
    cands = [c for c in fact_candidates(bl) if tried.get(c["id"], "") < week_ago]
    if not cands:
        return
    out_path = os.path.join(run_dir, "facts.json")
    own = urllib.parse.urlparse(site["production_url"]).netloc.replace("www.", "", 1)
    prompt = "\n".join([
        "You settle questions an SEO audit left for the business owner, using PUBLIC evidence only.",
        "Business: %s, website %s. Questions (JSON):" % (site.get("name", slug), site["production_url"]),
        "<<<UNTRUSTED>>>" + json.dumps(cands, indent=1)[:12000] + "<<<END>>>",
        "For each, decide its kind:",
        "- public_fact: a fact about the business that public records state (registered name, UEN via ACRA/bizfile or data.gov.sg, "
        "registered address, the phone/WhatsApp/email the business itself publishes on its Google Business Profile, other sites "
        "or social profiles). Research it with WebSearch/WebFetch/curl.",
        "- consent: whether named people, reviews, testimonials, credentials or clients are real or willing to be named.",
        "- secret: API keys, logins, account access, money or paid services.",
        "- preference: what the owner wants (prices, offers, wording, which option they prefer) with no public answer.",
        "Only public_fact can be answered. An answer needs at least %d sources on DIFFERENT domains, none of them %s "
        "(that site is what is being corrected), each with the exact quote that states the value. If sources disagree, "
        "answer null." % (FACT_MIN_SOURCES, own),
        "Write ONLY %s, ASCII, as {\"answers\": [{\"id\", \"kind\", \"answer\": string|null, \"sources\": "
        "[{\"url\", \"quote\"}], \"note\"}]}. Never invent a value. Never contact anyone or submit forms." % out_path,
    ])
    claude(cfg, "facts", prompt, run_dir, os.path.join(run_dir, "stdout.log"), [run_dir])
    data = read_json(out_path) or {}
    bl = load_backlog(slug)
    tried = bl.setdefault("facts_tried", {})
    for c in cands:
        tried[c["id"]] = d0
    for a in data.get("answers") or []:
        srcs = [x for x in a.get("sources") or [] if (x.get("quote") or "").strip() and x.get("url")]
        hosts = {urllib.parse.urlparse(x["url"]).netloc.replace("www.", "", 1) for x in srcs} - {own, ""}
        ok = a.get("kind") == "public_fact" and a.get("answer") and len(hosts) >= FACT_MIN_SOURCES
        log("%s find-facts %s kind=%s hosts=%d -> %s" % (slug, a.get("id"), a.get("kind"), len(hosts), "settled" if ok else "left for Leo"))
        if not ok:
            continue
        note = "%s (fact-finder %s; sources: %s)" % (a["answer"], d0, ", ".join(sorted(hosts)))
        if a.get("id") in bl["decisions"] and bl["decisions"][a["id"]].get("state") == "pending":
            bl["decisions"][a["id"]].update({"state": "decided", "answer": note, "decided_at": d0, "approved": True,
                                             "decided_by": "fact-finder"})
        elif a.get("id") in bl["items"] and bl["items"][a["id"]].get("state") in ("owner_pending", "owner_action"):
            bl["items"][a["id"]].update({"state": "approved", "owner_note": note, "approved_by": "fact-finder",
                                         "approved_at": d0, "impl_attempts": 0, "decided_at": d0})
    save_backlog(slug, bl)


def auto_decide(slug, dry_run=False):
    """Decide what the pipeline can decide itself. Returns [(id, p, outcome)]."""
    key = jev_key()
    if not key:
        log("%s auto-decide skipped: no TYPESAFE_API_KEY" % slug)
        return []
    bl = load_backlog(slug)
    d0, out = today().isoformat(), []
    for d in bl["decisions"].values():
        if d.get("state") != "pending" or not d.get("recommendation"):
            continue
        p = jev_owner_only({"question": d.get("question"), "options": d.get("options"),
                            "recommendation": d.get("recommendation"), "why": d.get("why")}, key)
        if p is None or p >= OWNER_ONLY_MAX:
            out.append((d["id"], p, "left for Leo"))
            continue
        out.append((d["id"], p, "decided"))
        if not dry_run:
            d.update({"state": "decided", "answer": d["recommendation"], "decided_at": d0, "approved": True,
                      "decided_by": "auto-decide (%s, owner_only %.2f)" % (JEV_MODEL, p)})
    for it in bl["items"].values():
        if it.get("state") != "owner_pending":
            continue
        if it.get("change_class") == "business_fact" or any(
                f.startswith(OWNER_ONLY_PATHS) or "/.env" in f for f in it.get("files") or []):
            out.append((it["id"], None, "left for Leo (business fact or protected path)"))
            continue
        p = jev_owner_only({"title": it.get("title"), "change_class": it.get("change_class"),
                            "recommendation": it.get("action"), "evidence": str(it.get("evidence"))[:1500],
                            "risk": it.get("risk")}, key)
        if p is None or p >= OWNER_ONLY_MAX:
            out.append((it["id"], p, "left for Leo"))
            continue
        out.append((it["id"], p, "approved"))
        if not dry_run:
            it.update({"state": "approved", "approved_by": "auto-decide (%s, owner_only %.2f)" % (JEV_MODEL, p),
                       "approved_at": d0, "impl_attempts": 0, "decided_at": d0})
    if not dry_run:
        save_backlog(slug, bl)
    for ident, p, what in out:
        log("%s auto-decide %s %s (owner_only %s)" % (slug, ident, what, "n/a" if p is None else "%.2f" % p))
    return out


def cmd_auto_decide(slugs, dry_run=False):
    for slug in slugs:
        fh = site_lock(slug, block=True)
        try:
            for ident, p, what in auto_decide(slug, dry_run):
                print("%s %s %s %s" % (slug, ident, "n/a " if p is None else "%.2f" % p, what))
        finally:
            release(fh)
    write_status()
    return 0


def approved_items(slug, cfg, consume=False):
    bl = load_backlog(slug)
    items = [i for i in bl["items"].values() if i.get("state") == "approved"
             and i.get("surface") in ("repo", "hosting")
             and i.get("impl_attempts", 0) < cfg["implement"]["max_impl_attempts"]]
    items.sort(key=lambda i: (SEVERITY_RANK.get(i.get("severity"), 9), i.get("first_seen", "")))
    if bl.get("shrink_next"):
        if consume:
            bl.pop("shrink_next")
            save_backlog(slug, bl)
            log("%s: last change set timed out, taking one item" % slug)
        return items[:1]
    return items[: cfg["implement"]["max_items"]]


def set_items(slug, ids, **fields):
    bl = load_backlog(slug)
    for i in ids:
        if i in bl["items"]:
            bl["items"][i].update(fields)
    save_backlog(slug, bl)


