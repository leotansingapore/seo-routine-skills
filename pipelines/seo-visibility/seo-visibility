def vercel_token():
    auth = read_json(VERCEL_AUTH, {}) or {}
    exp = auth.get("expiresAt")
    if isinstance(exp, (int, float)) and exp < time.time() + 300:
        try:
            sh(["vercel", "whoami"], timeout=120, check=False)  # the CLI refreshes its own OAuth token
        except Exception as e:
            log("vercel token refresh failed: %s" % e)
        auth = read_json(VERCEL_AUTH, {}) or {}
    return auth.get("token")


def vercel_get(path):
    req = urllib.request.Request("https://api.vercel.com" + path, headers={"Authorization": "Bearer " + (vercel_token() or "")})
    return json.loads(urllib.request.urlopen(req, timeout=30).read().decode())


