def lark(text, cfg=None, webhook=None):
    """Post to Lark. webhook overrides the combined SEO group (used for per-site groups)."""
    cfg = cfg or load_config()
    url = webhook or cfg.get("lark_webhook")
    text = text.encode("ascii", "replace").decode("ascii")
    if not url:
        log("lark: no webhook configured; message dropped: " + text[:200])
        return False
    body = json.dumps({"msg_type": "text", "content": {"text": text}}).encode()
    try:
        req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
        resp = json.loads(urllib.request.urlopen(req, timeout=20).read().decode() or "{}")
        code = resp.get("code", resp.get("StatusCode", 0))
        if code not in (0, None):
            log("lark refused: %s" % resp)
            return False
        return True
    except Exception as e:  # never let an alert kill a job
        log("lark error: %s" % e)
        return False


def lark_card(card, cfg=None, webhook=None):
    """Post a Card 2.0 message (bold, coloured blocks). False on any refusal so callers can fall back to text."""
    cfg = cfg or load_config()
    url = webhook or cfg.get("lark_webhook")
    if not url:
        return False
    body = json.dumps({"msg_type": "interactive", "card": card}, ensure_ascii=True).encode()
    try:
        req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
        resp = json.loads(urllib.request.urlopen(req, timeout=20).read().decode() or "{}")
        code = resp.get("code", resp.get("StatusCode", 0))
        if code not in (0, None):
            log("lark card refused: %s" % resp)
            return False
        return True
    except Exception as e:
        log("lark card error: %s" % e)
        return False


def alert_once(key, text, every_hours=24):
    """Rate-limited alert. Uses a stamp file rather than state.json, so it is safe to call anywhere."""
    os.makedirs(STATE_DIR, exist_ok=True)
    stamp = os.path.join(STATE_DIR, "alert-%s.stamp" % re.sub(r"[^A-Za-z0-9_.-]", "_", key))
    if os.path.exists(stamp) and time.time() - os.path.getmtime(stamp) < every_hours * 3600:
        return False
    with open(stamp, "w") as f:
        f.write(iso())
    return lark(text)


# ---------------------------------------------------------------- prompts (Notion sync)

def _notion_blocks():
    blocks, cursor, n = {}, {"stack": []}, 0
    while True:
        body = json.dumps({"page": {"id": NOTION_PAGE}, "limit": 500, "cursor": cursor,
                           "chunkNumber": n, "verticalColumns": False}).encode()
        req = urllib.request.Request("https://www.notion.so/api/v3/loadCachedPageChunk", data=body,
                                     headers={"content-type": "application/json"})
        d = json.load(urllib.request.urlopen(req, timeout=60))
        for k, v in d["recordMap"].get("block", {}).items():
            val = v.get("value", {})
            if isinstance(val.get("value"), dict):
                val = val["value"]
            blocks[k] = val
        cursor = d.get("cursor") or {"stack": []}
        n += 1
        if not cursor.get("stack"):
            return blocks


def _btext(b):
    return "".join(x[0] for x in b.get("properties", {}).get("title", []))


def extract_library(blocks):
    """Returns (files: {name: text}, source_markdown)."""
    root = blocks[NOTION_PAGE]
    files, lines, header, sub = {}, [], "", ""
    contract = []
    for bid in root.get("content", []):
        b = blocks.get(bid) or {}
        t, s = b.get("type"), _btext(b)
        if t == "header":
            header, sub = s, ""
            lines.append("# " + s)
        elif t == "sub_header":
            sub = s
            lines.append("## " + s)
        elif t == "code":
            lines.append("```\n" + s + "\n```")
            m = re.match(r"Prompt (\d)\b", header)
            if sub.startswith("Fixed AI-query panel"):
                files["query-panel-template.md"] = s
            elif m:
                name = [v for v in PROMPT_FILES.values() if v.startswith("0%s-" % m.group(1))]
                if name:
                    files[name[0]] = s
            elif header.startswith("Optional prompt"):
                files["10-implement.md"] = s
        elif t == "table":
            for rid in b.get("content", []):
                r = blocks.get(rid) or {}
                props = r.get("properties", {})
                row = "| " + " | ".join("".join(x[0] for x in props[c]) for c in props) + " |"
                lines.append(row)
                if sub in ("Standard audit contract", "Required report format"):
                    contract.append(row)
        else:
            pre = {"bulleted_list": "- ", "numbered_list": "1. "}.get(t, "")
            lines.append(pre + s)
            if sub in ("Standard audit contract", "Required report format"):
                contract.append(pre + s)
            elif t == "text" and header.startswith("Prompt") and s.startswith("Cadence"):
                lines.append("")
    if contract:
        files["contract.md"] = ("Standard audit contract and required report format, verbatim from the "
                                "library:\n\n" + "\n".join(contract))
    return files, "\n".join(lines)


def cmd_sync_prompts(quiet=False):
    try:
        files, source = extract_library(_notion_blocks())
    except Exception as e:
        alert_once("sync-fail", "SEO visibility: could not fetch the prompt library from Notion (%s). "
                   "Existing prompts kept." % e, every_hours=24 * 7)
        return 1
    needed = set(PROMPT_FILES.values()) | {"query-panel-template.md", "contract.md"}
    missing = sorted(needed - set(files))
    if missing:
        alert_once("sync-shape", "SEO visibility: the Notion prompt library changed shape; missing %s. "
                   "Existing prompts kept, nothing updated." % ", ".join(missing), every_hours=24 * 7)
        return 1
    os.makedirs(PROMPTS, exist_ok=True)
    changed = []
    for name, text in sorted(files.items()):
        path = os.path.join(PROMPTS, name)
        old = open(path).read() if os.path.exists(path) else None
        if old != text:
            changed.append((name, old is None))
            with open(path, "w") as f:
                f.write(text)
    with open(os.path.join(PROMPTS, "library-source.md"), "w") as f:
        f.write(source)
    real = [n for n, first in changed if not first]
    if changed:
        with open(os.path.join(PROMPTS, "CHANGELOG.md"), "a") as f:
            f.write("%s: %s %s\n" % (today(), "updated" if real else "created",
                                     ", ".join(n for n, _ in changed)))
    if real:
        lark("SEO visibility: the Notion prompt library changed (%s). New wording is live from the "
             "next run. Log: %s/CHANGELOG.md" % (", ".join(real), PROMPTS))
    if not quiet:
        print("prompts: %d files, %d changed" % (len(files), len(changed)))
    return 0


def read_prompt(kind):
    with open(os.path.join(PROMPTS, PROMPT_FILES[kind])) as f:
        return f.read()


# ---------------------------------------------------------------- calendar

def nth_weekday(year, month, weekday, n):
    first = dt.date(year, month, 1)
    d = first + dt.timedelta(days=(weekday - first.weekday()) % 7 + 7 * (n - 1))
    return d if d.month == month else None


def prev_quarter_label(day):
    q = (day.month - 1) // 3 + 1
    y = day.year
    q -= 1
    if q == 0:
        q, y = 4, y - 1
    return "%d-Q%d" % (y, q)


def quarter_months(label):
    y, q = label.split("-Q")
    first = 3 * (int(q) - 1) + 1
    return ["%s-%02d" % (y, m) for m in range(first, first + 3)]


def audit_slots(cfg, slug, day, publishing_active=True):
    """Audit (type, period, scheduled_date) whose period contains `day`."""
    out = []
    iy, iw, _ = day.isocalendar()
    if publishing_active:
        pulse_day = day - dt.timedelta(days=day.weekday()) + dt.timedelta(days=cfg["pulse_weekday"])
        out.append(("pulse", "%d-W%02d" % (iy, iw), pulse_day))
    else:  # the library: weekly while publishing, otherwise monthly is enough
        out.append(("pulse", "%d-%02d" % (day.year, day.month),
                    nth_weekday(day.year, day.month, cfg["pulse_weekday"], 1)))
    wd = cfg["site_weekday"].get(slug, 1)
    for i, t in enumerate(SPECIALISTS):
        out.append((t, "%d-%02d" % (day.year, day.month), nth_weekday(day.year, day.month, wd, i + 1)))
    if day.month in (1, 4, 7, 10):
        out.append(("quarterly", prev_quarter_label(day),
                    nth_weekday(day.year, day.month, cfg["quarterly_weekday"].get(slug, 5), 1)))
    return out


def cmd_calendar(days=42):
    cfg = load_config()
    start = today()
    base = dt.date.fromisoformat(cfg["installed_at"])
    for i in range(days):
        d = start + dt.timedelta(days=i)
        items = []
        for slug in site_slugs() or list(cfg["site_weekday"]):
            for t, period, sched in audit_slots(cfg, slug, d):
                if sched != d:
                    continue
                if t == "pulse" and sched <= base:
                    continue
                if t in SPECIALISTS and sched < base + dt.timedelta(days=cfg["specialist_min_days_after_baseline"]):
                    continue
                items.append("%s:%s" % (slug, t))
        if d.weekday() == cfg["digest"]["weekday"]:
            items.append("digest")
        if items:
            print("%s %s  %s" % (d, d.strftime("%a"), "  ".join(items)))


# ---------------------------------------------------------------- git activity

def clone_or_repo(site):
    work = os.path.join(WORK, site.get("slug", ""))
    return work if os.path.isdir(os.path.join(work, ".git")) else site.get("repo_path")


def refresh_clones(max_age_h=12):
    """Keep each clone's origin refs fresh for scheduling decisions (activity, re-baseline)."""
    for slug in site_slugs():
        work = os.path.join(WORK, slug)
        head = os.path.join(work, ".git", "FETCH_HEAD")
        if not os.path.isdir(os.path.join(work, ".git")):
            continue
        if os.path.exists(head) and time.time() - os.path.getmtime(head) < max_age_h * 3600:
            continue
        fh = site_lock(slug)
        if not fh:
            continue  # a job is using the clone; it fetches itself
        try:
            git(work, "fetch", "-q", "origin", "--prune", check=False, timeout=300)
        except Exception as e:
            log("refresh_clones %s: %s" % (slug, e))
        finally:
            release(fh)


def publishing_active(site, days):
    repo = clone_or_repo(site)
    if not repo or not os.path.isdir(repo):
        return True
    try:
        rc, out = git(repo, "log", "-n", "200", "--since=%d.days" % days, "--format=%s%n%b%x00", "origin/" +
                      site.get("default_branch", "main"), check=False, timeout=60)
    except subprocess.TimeoutExpired:   # retro 2026-W40: 36 timeouts each skipped a site's whole due_jobs pass
        log("publishing_active %s: git log timed out; assuming active" % site.get("slug", "?"))
        return True
    if rc != 0:
        return True
    commits = [c for c in out.split("\x00") if c.strip() and "[seo-visibility]" not in c]
    return len(commits) > 0


# ---------------------------------------------------------------- due jobs

def job_eligible(st, key, cfg, t=None):
    t = t or now()
    if key in st["running"]:
        return False
    j = st["jobs"].get(key)
    if not j:
        return True
    if j.get("status") in ("done", "skipped"):
        return False
    last = j.get("last_attempt")
    age = (t - dt.datetime.fromisoformat(last)).total_seconds() if last else None
    if j.get("attempts", 0) >= cfg["max_attempts"]:
        # a site's baseline gates everything else for that site, so it gets another round every 3 days
        return "|baseline|" in key and age is not None and age >= 72 * 3600
    gap = 30 if j.get("status") == "deferred" else cfg["retry_gap_min"]
    return age is None or age >= gap * 60


def done_runs(st, slug, jtype):
    return sorted((k.split("|")[2], v) for k, v in st["jobs"].items()
                  if k.startswith(slug + "|" + jtype + "|") and v.get("status") == "done")


def pipe(site):
    return (site or {}).get("pipeline") or {}


def blackout_active(site, t):
    """pipeline.blackout: list of {"weekday": 0-6 or null, "start": "HH:MM", "end": "HH:MM"}."""
    for w in pipe(site).get("blackout") or []:
        if not isinstance(w, dict):
            continue
        if w.get("weekday") is not None and int(w["weekday"]) != t.weekday():
            continue
        s, e = w.get("start", "00:00"), w.get("end", "23:59")
        hm = t.strftime("%H:%M")
        if s <= hm <= e:
            return True
    return False


def implement_allowed(cfg, site):
    if not cfg["implement"]["enabled"] or not site:
        return False, "implementation disabled"
    p = pipe(site)
    if p.get("implement_enabled") is False:
        return False, "pipeline.implement_enabled is false in site.json"
    if p.get("deploy_mode") not in ("push", "cli", "push_and_cli"):
        return False, "no verified deploy recipe (pipeline.deploy_mode) in site.json"
    if p.get("deploy_mode") != "push" and (site.get("worktree_deploy") or {}).get("safe") is not True:
        return False, "deploying from a clean clone is not verified safe"
    if not p.get("required_author_email") or not p.get("vercel_project_id"):
        return False, "pipeline block lacks required_author_email or vercel_project_id"
    return True, ""


def preflight(site, work):
    """Reasons not to ship right now (empty list = clear)."""
    reasons = []
    for pat in pipe(site).get("preflight_pgrep") or []:
        rc, out = sh(["pgrep", "-f", pat], check=False)
        if rc == 0 and out.strip():
            reasons.append("a process matching %s is running" % pat)
    try:
        prod = latest_production(site, work)
    except Exception as e:
        return reasons + ["cannot read the production deployment from Vercel (%s)" % str(e)[:120]]
    if prod and prod.get("sha"):
        main = "origin/" + site.get("default_branch", "main")
        rc, _ = git(work, "merge-base", "--is-ancestor", prod["sha"], main, check=False)
        if rc != 0:  # our copy of origin/main may simply be behind a peer's push
            git(work, "fetch", "-q", "origin", "--prune", check=False, timeout=900)
            rc, _ = git(work, "merge-base", "--is-ancestor", prod["sha"], main, check=False)
        if rc != 0:
            reasons.append("production serves %s, which is not on %s (someone deployed unpushed work)" % (prod["sha"][:9], main))
    return reasons


DUE_ERRORS = []


def site_due(cfg, st, t, slug):
    day = t.date()
    jobs = []
    site = load_site(slug)
    if not site or not site.get("production_url"):
        return jobs
    base = st["baselines"].get(slug)
    if not base:
        key = "%s|baseline|initial" % slug
        if job_eligible(st, key, cfg, t):
            jobs.append((slug, "baseline", "initial"))
        return jobs
    base_day = dt.date.fromisoformat(base["date"])
    # re-baseline after a redesign-sized change (not our own commits)
    rb = cfg["rebaseline"]
    if (day - base_day).days >= rb["min_age_days"] and base.get("sha"):
        ratio = changed_ratio(site, base["sha"])
        if ratio is not None and ratio >= rb["changed_ratio"]:
            key = "%s|baseline|%s" % (slug, day.strftime("%Y-%m"))
            if job_eligible(st, key, cfg, t):
                return [(slug, "baseline", day.strftime("%Y-%m"))]
    active30 = publishing_active(site, 30)
    active90 = active30 or publishing_active(site, 90)
    for jtype, period, sched in audit_slots(cfg, slug, day, active30):
        if sched is None or sched > day:
            continue
        if jtype == "pulse" and sched <= base_day:
            continue
        if jtype in SPECIALISTS:
            if sched < base_day + dt.timedelta(days=cfg["specialist_min_days_after_baseline"]):
                continue
            if jtype == "backlinks" and not active90 and day.month not in (3, 6, 9, 12):
                continue  # the library: quarterly may be enough for a quieter site
        key = "%s|%s|%s" % (slug, jtype, period)
        if jtype == "quarterly" and st["jobs"].get(key, {}).get("status") != "done":
            months = quarter_months(period)
            have = {tp for tp in ("technical", "content", "ai")
                    if any(p in months for p, _ in done_runs(st, slug, tp))}
            if len(have) < 3:
                continue  # re-checked on the next tick; a record here would cancel the quarter for good
        if job_eligible(st, key, cfg, t):
            jobs.append((slug, jtype, period))
    changes = read_json_strict(sp(slug)["changes"], {}) or {}
    # 7 and 28 day validations of shipped change sets
    for cid, cs in sorted(changes.items()):
        if cs.get("state") != "shipped":
            continue
        for phase in ("d7", "d28"):
            v = (cs.get("validation") or {}).get(phase) or {}
            if v.get("due") and dt.date.fromisoformat(v["due"]) <= day and not v.get("verdict"):
                key = "%s|validate-%s|%s" % (slug, phase, cid)
                if job_eligible(st, key, cfg, t):
                    jobs.append((slug, "validate-" + phase, cid))
    # implementation of approved findings: at most one run a day, and max_per_week change sets that reached main
    ok, _ = implement_allowed(cfg, site)
    if ok and approved_items(slug, cfg) and not blackout_active(site, t):
        iy, iw, _ = day.isocalendar()
        pushed = [c for c in changes.values() if c.get("pushed_at")
                  and dt.date.fromisoformat(c["pushed_at"][:10]).isocalendar()[:2] == (iy, iw)]
        cap = cfg["implement"].get("max_per_day", 3)
        today_done = sum(1 for k, v in st["jobs"].items()
                         if k.startswith("%s|implement|%s" % (slug, day.isoformat())) and v.get("status") in ("done", "failed"))
        for n in range(1, cap + 1):
            period = "%s-%d" % (day.isoformat(), n)
            key = "%s|implement|%s" % (slug, period)
            if key in st["jobs"] and st["jobs"][key].get("status") in ("done", "failed", "skipped"):
                continue  # that slot is used; try the next free one
            if (len(pushed) < cfg["implement"]["max_per_week"] and today_done < cap
                    and job_eligible(st, key, cfg, t)):
                jobs.append((slug, "implement", period))
            break
    return jobs


def due_jobs(cfg, st, t=None):
    """Due jobs in run order. A site whose files or git state break scheduling is skipped and recorded in
    DUE_ERRORS (the caller alerts outside the state lock); the other sites still run."""
    t = t or now()
    day = t.date()
    jobs = []
    del DUE_ERRORS[:]
    for slug in site_slugs():
        try:
            jobs.extend(site_due(cfg, st, t, slug))
        except Exception as e:
            DUE_ERRORS.append((slug, "%s: %s" % (type(e).__name__, str(e)[:300])))
            log("due_jobs %s failed: %s" % (slug, traceback.format_exc()[-800:]))
    iy, iw, _ = day.isocalendar()
    if day.weekday() == cfg["sync_weekday"]:
        key = "_all|sync|%d-W%02d" % (iy, iw)
        if job_eligible(st, key, cfg, t):
            jobs.append(("_all", "sync", "%d-W%02d" % (iy, iw)))
    if day.weekday() == cfg["digest"]["weekday"]:
        key = "_all|retro|%d-W%02d" % (iy, iw)
        if job_eligible(st, key, cfg, t):
            jobs.append(("_all", "retro", "%d-W%02d" % (iy, iw)))
    if day.weekday() == cfg["digest"]["weekday"] and t.hour >= cfg["digest"]["hour"]:
        key = "_all|digest|%d-W%02d" % (iy, iw)
        if job_eligible(st, key, cfg, t):
            jobs.append(("_all", "digest", "%d-W%02d" % (iy, iw)))
    order = {"baseline": 0, "pulse": 1, "technical": 2, "content": 2, "backlinks": 2, "ai": 2,
             "quarterly": 3, "validate-d7": 4, "validate-d28": 4, "implement": 5, "sync": 6, "retro": 6, "digest": 7}
    jobs.sort(key=lambda j: order.get(j[1], 9))
    return jobs


def changed_ratio(site, base_sha):
    """Share of tracked files changed since the baseline by commits that are not the pipeline's own."""
    repo = clone_or_repo(site)
    if not repo or not os.path.isdir(repo):
        return None
    rng = "%s..origin/%s" % (base_sha, site.get("default_branch", "main"))
    rc, out = git(repo, "log", "--format=%x00%H", "--name-only", "--no-renames", rng, check=False, timeout=120)
    if rc != 0:
        return None
    rc2, ours = git(repo, "log", "--format=%H", "--fixed-strings", "--grep=[seo-visibility]", rng,
                    check=False, timeout=120)
    ours = set(ours.split()) if rc2 == 0 else set()
    files = set()
    for chunk in out.split("\x00"):
        lines = [l for l in chunk.splitlines() if l.strip()]
        if lines and lines[0] not in ours:
            files.update(lines[1:])
    rc, tracked = git(repo, "ls-files", check=False, timeout=120)
    total = len(tracked.splitlines()) or 1
    return len(files) / float(total)


# ---------------------------------------------------------------- dispatch

def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def site_lock(slug, block=False):
    """An open, flock-held file for the site, or None when another process holds it."""
    os.makedirs(STATE_DIR, exist_ok=True)
    fh = open(os.path.join(STATE_DIR, slug + ".lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
        return fh
    except (BlockingIOError, OSError):
        fh.close()
        return None


def release(fh):
    if fh:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def repair_stuck(slug, reason):
    """Undo what a dead implement run left behind. The caller holds the site lock. Returns alert texts."""
    msgs = []
    allcs = read_json_strict(sp(slug)["changes"], {}) or {}
    live_ids, changed = set(), False
    for cs in allcs.values():
        was = cs.get("state")
        if was not in ("implementing", "gating", "deploying", "validating"):
            continue
        changed = True
        cs.setdefault("notes", []).append("%s: %s (was %s)" % (iso(), reason, was))
        cs_dir = os.path.join(sp(slug)["cs"], cs["id"])
        if cs.get("pushed_at"):
            d = dt.date.fromisoformat(cs["pushed_at"][:10])
            cs["state"] = "shipped"
            val = cs.setdefault("validation", {})
            val.setdefault("immediate", {"verdict": "unverified: the run died", "at": iso()})
            val.setdefault("d7", {"due": (d + dt.timedelta(days=7)).isoformat()})
            val.setdefault("d28", {"due": (d + dt.timedelta(days=28)).isoformat()})
            live_ids.update(cs.get("items", []))
            msgs.append("SEO visibility: %s change set %s is LIVE (commits %s) but its run died while %s, so it was "
                        "not validated. The 7-day check will look at it; worth a glance at the site. Details: %s" % (
                            slug, cs["id"], ",".join(c[:9] for c in cs.get("commits", [])), was, cs_dir))
        else:
            cs["state"] = "crashed"
            msgs.append("SEO visibility: %s change set %s died while %s, before anything was pushed. Its items are "
                        "queued again. Details: %s" % (slug, cs["id"], was, cs_dir))
    if changed:
        write_json(sp(slug)["changes"], allcs)
    bl = load_backlog(slug)
    touched = False
    for it in bl["items"].values():
        if it.get("state") == "in_progress":
            touched = True
            if it["id"] in live_ids:
                it.update({"state": "shipped", "live_status": "cannot_verify"})
            else:
                it["state"] = "approved"
    if touched:
        save_backlog(slug, bl)
    return msgs


def cmd_dispatch(dry_run=False):
    try:
        return _dispatch(dry_run)
    except Exception as e:
        log("dispatch crashed: %s" % traceback.format_exc()[-1500:])
        if not dry_run:
            alert_once("dispatch-crash", "SEO visibility: the scheduler fails on every tick, so nothing runs: %s. "
                       "Log: %s/seo-visibility.log" % (str(e)[:300], LOGS), every_hours=24)
        return 1


def _dispatch(dry_run):
    cfg = load_config()
    if dry_run:  # read-only: works on a copy and never reaps, repairs or spawns
        st = copy.deepcopy(read_state())
        for j in due_jobs(cfg, st):
            print("due: %s %s %s" % j)
        for slug, err in DUE_ERRORS:
            print("error: %s %s" % (slug, err))
        print("running: %s" % (", ".join(sorted(st["running"])) or "none"))
        return 0
    if not network_up():
        log("dispatch: github.com unreachable, not starting jobs")
        return 0
    if cfg.get("_invalid"):
        alert_once("config-invalid", "SEO visibility: config.json is invalid (%s). Audits continue on defaults; "
                   "implementation stays off until it is fixed." % cfg["_invalid"][:200], every_hours=24)
    if not os.path.exists(os.path.join(PROMPTS, PROMPT_FILES["baseline"])):
        cmd_sync_prompts(quiet=True)
    if not os.path.exists(os.path.join(STATE_DIR, "access-probe.json")):
        access_probe()
    free = disk_free_gb()
    if free < cfg["min_free_gb"]:
        log("dispatch: only %.1f GB free, not starting jobs" % free)
        alert_once("disk", "SEO visibility paused: only %.1f GB free on the Mac (needs %s GB). Jobs resume by "
                   "themselves once space is freed." % (free, cfg["min_free_gb"]))
        return 0
    if limit_active():
        log("dispatch: Claude usage limit flag active, skipping tick")
        return 0
    refresh_clones()
    with Locked() as st:
        for key, r in list(st["running"].items()):
            stale = r.get("started") and (now() - dt.datetime.fromisoformat(r["started"])).total_seconds() > 6 * 3600
            if not pid_alive(r.get("pid")) or stale:
                j = st["jobs"].setdefault(key, {})
                j.update({"status": "failed", "note": "process vanished (crash, reboot or kill)"})
                del st["running"][key]
        busy = {k.split("|")[0] for k in st["running"]}
    # anything an implement run left half done, for sites no job holds right now
    for slug in site_slugs():
        if slug in busy:
            continue
        fh = site_lock(slug)
        if not fh:
            continue
        try:
            for msg in repair_stuck(slug, "found stuck by the scheduler (the run died)"):
                lark(msg)
        except Exception as e:
            log("repair_stuck %s failed: %s" % (slug, e))
        finally:
            release(fh)
    with Locked() as st:
        due = due_jobs(cfg, st)
        busy = {k.split("|")[0] for k in st["running"]}
        par = cfg["max_parallel"]
        if os.getloadavg()[0] > 1.5 * (os.cpu_count() or 8):
            par = 1   # 2026-10-03: at load ~28 a gate sat 90 min without output; fewer jobs finish, more jobs hang
        slots = par - len(st["running"])
    for slug, err in list(DUE_ERRORS):
        alert_once("due-%s" % slug, "SEO visibility: cannot schedule %s: %s" % (slug, err), every_hours=24)
    for slug, jtype, period in due:
        if slug == "_all":
            run_global(jtype, period)
            continue
        if slots <= 0 or slug in busy:
            continue
        os.makedirs(LOGS, exist_ok=True)
        lf = open(os.path.join(LOGS, "jobs.log"), "a")
        p = subprocess.Popen([sys.executable, SELF, "run", slug, jtype, "--period", period],
                             stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, start_new_session=True,
                             env=dict(os.environ, PATH=PATH_ENV))
        with Locked() as st:
            st["running"]["%s|%s|%s" % (slug, jtype, period)] = {"pid": p.pid, "started": iso()}
        log("dispatch: started %s %s %s pid=%s" % (slug, jtype, period, p.pid))
        busy.add(slug)
        slots -= 1
    write_status()
    try:
        notify_site_queues(cfg)
    except Exception:
        log("notify_site_queues failed: " + traceback.format_exc()[-800:])
    return 0


def access_probe():
    """Weekly: what Search Console / GA4 / Bing data this machine can read; alert when it changes."""
    path = os.path.join(STATE_DIR, "access-probe.json")
    old = read_json(path, {}) or {}
    rc, out = sh([sys.executable, os.path.join(ROOT, "bin", "gdata.py"), "probe"], timeout=300, check=False)
    try:
        new = json.loads(out)
    except ValueError:
        log("access probe failed: %s" % out[-300:])
        return 1
    write_json(path, new)
    gained = []
    for slug, cur in (new.get("sites") or {}).items():
        before = (old.get("sites") or {}).get(slug, {})
        for src in ("gsc", "ga4", "bing"):
            if cur.get(src) and not before.get(src):
                gained.append("%s %s" % (slug, src.upper()))
    if gained and old:
        lark("SEO visibility: search data access now works for %s. Audits use it from their next run." % ", ".join(gained))
    return 0


def retro_evidence():
    """What happened to the pipeline's own work in the last 28 days, per site."""
    cut = (today() - dt.timedelta(days=28)).isoformat()
    old = (today() - dt.timedelta(days=14)).isoformat()
    ev = {"since": cut, "sites": {}}
    for slug in site_slugs():
        bl = load_backlog(slug)
        items = list(bl["items"].values())
        states = {}
        for i in items:
            states[i.get("state")] = states.get(i.get("state"), 0) + 1
        ev["sites"][slug] = {
            "states": states,
            "stuck_over_14d": [{"id": i["id"], "state": i.get("state"), "class": i.get("change_class"),
                                "title": i.get("title"), "first_seen": i.get("first_seen")} for i in items
                               if i.get("state") in ("owner_pending", "owner_action", "blocked", "not_fixed")
                               and (i.get("first_seen") or "9") < old][:25],
            "reopened": [i["id"] for i in items if (i.get("reopened") or "") >= cut],
            "rejected_by_leo": [[i["id"], i.get("title"), i.get("owner_note")] for i in items
                                if i.get("state") == "rejected" and (i.get("decided_at") or "") >= cut],
            "not_fixed_live": [[i["id"], i.get("title")] for i in items if i.get("live_status") in ("not_fixed", "regressed")],
            "changesets": changesets_summary(slug)[-15:],
