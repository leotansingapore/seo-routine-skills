def run_audit(cfg, site, slug, jtype, period):
    run_dir = new_run_dir(slug, jtype)
    work, sha = prepare_clone(site, slug)
    prompt = read_prompt(jtype) + "\n" + audit_context(cfg, site, slug, jtype, run_dir, work, sha)
    write_json(os.path.join(run_dir, "meta.json"), {"site": slug, "type": jtype, "period": period,
                                                     "sha": sha, "started": iso(), "model": cfg["models"][jtype]})
    add = [run_dir, "/private/tmp"]
    rc = claude(cfg, jtype, prompt, work, os.path.join(run_dir, "stdout.log"), add)
    if rc == 75:
        return 75, {"note": "deferred: Claude " + LAST_DEFER["why"], "run_dir": run_dir}
    if rc == TAMPERED:
        return 1, {"note": "discarded: the agent modified pipeline policy files (restored)", "run_dir": run_dir}
    staged_panel = os.path.join(run_dir, "query-panel.md")
    if os.path.exists(staged_panel) and not os.path.exists(sp(slug)["panel"]):
        shutil.copy(staged_panel, sp(slug)["panel"])  # the orchestrator installs it; agents cannot write the site dir
    report = os.path.join(run_dir, "report.md")
    if not os.path.exists(report) or os.path.getsize(report) < 800:
        return 1, {"note": "no report written (claude rc=%s%s)" % (rc, ", timed out" if rc == 124 else ""),
                   "run_dir": run_dir}
    fpath = os.path.join(run_dir, "findings.json")
    data = read_json(fpath)
    err = validate_findings(data) if data is not None else "findings.json missing or invalid JSON"
    if err:
        repair = ("Convert the audit report at %s into %s following this schema exactly. Read the backlog at %s "
                  "to reuse ids for the same issues. Write only that file, valid JSON, ASCII only. The previous "
                  "attempt failed validation with: %s\n\n%s") % (report, fpath, sp(slug)["backlog"], err, FINDINGS_SCHEMA)
        claude(cfg, "repair", repair, run_dir, os.path.join(run_dir, "stdout.log"), [run_dir])
        data = read_json(fpath)
        err = validate_findings(data) if data is not None else "findings.json still invalid"
        if err:
            return 1, {"note": "report written but findings unusable: " + err, "run_dir": run_dir}
    rc2, dirty = git(work, "status", "--porcelain", "--untracked-files=no", check=False)
    if dirty.strip():
        log("%s %s: auditor modified tracked files in the clone (discarded): %s" % (slug, jtype, dirty[:300]))
        git(work, "reset", "--hard", check=False)
    new_p0 = merge_backlog(cfg, slug, data, run_dir, jtype)
    auto_decide(slug)
    try:
        find_facts(cfg, site, slug, run_dir)
    except Exception:
        log("%s find_facts failed: %s" % (slug, traceback.format_exc()[-600:]))
    # Search Console sitemaps are the pipeline's job, not Leo's (his call, 2026-10-03)
    try:
        rc3, out3 = sh([sys.executable, os.path.join(ROOT, "bin", "gdata.py"), "gsc-sync-sitemaps", slug], timeout=300, check=False)
    except Exception as e:
        rc3, out3 = "exc", str(e)
    log("%s gsc-sync-sitemaps rc=%s %s" % (slug, rc3, (out3 or "").replace("\n", " ")[:400]))
    for item in new_p0:
        route = {"approved": "auto-fix queued", "owner_pending": "needs your decision",
                 "owner_action": "needs you to act outside the repo"}.get(item["state"], item["state"])
        lark("SEO visibility P0 on %s: %s %s. %s. Report: %s" % (site["production_url"], item["id"],
                                                                  item.get("title"), route, report))
        if site_webhook(cfg, slug):
            urgent = "%s: urgent SEO problem found. %s (%s). Status: %s." % (site_name(slug), item.get("title"), item["id"], route)
            send_site(cfg, site_webhook(cfg, slug), _card("%s: urgent SEO problem" % site_name(slug), route, 1, [
                _block("red", [{"tag": "markdown", "content": "**%s**\n<font color='grey'>%s</font>" % (md(item.get("title")), md(item["id"]))}])]), urgent)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    meta.update({"finished": iso(), "claude_rc": rc, "verdict": data.get("verdict"),
                 "verdict_line": data.get("verdict_line"), "findings": len(data.get("findings", []))})
    write_json(os.path.join(run_dir, "meta.json"), meta)
    return 0, {"run_dir": run_dir, "sha": sha, "note": data.get("verdict_line") or ""}


