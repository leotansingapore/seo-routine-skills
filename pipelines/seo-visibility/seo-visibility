def limit_active():
    """True while Claude jobs should wait: the shared claude-resilient flag, or a limit this pipeline saw itself.
    claude -p prints the limit on STDOUT, which claude-resilient.sh (stderr only) does not catch."""
    try:
        if int(open(LIMIT_FLAG).read().strip() or 0) > time.time():
            # same rule as claude-resilient.sh: a flag set under another account is stale (2026-10-03 it paused every site)
            saved = read_text(os.path.join(os.path.dirname(LIMIT_FLAG), "account"))
            if not (saved and account_fp() and saved != account_fp()):
                return True
    except (OSError, ValueError):
        pass
    d = read_json(os.path.join(STATE_DIR, "claude-limit.json"))
    if not d or not d.get("until") or now() >= dt.datetime.fromisoformat(d["until"]):
        return False
    fp = account_fp()
    return not (fp and d.get("account") and fp != d["account"])  # a switched account has its own quota


class Locked(object):
    """flock-guarded read-modify-write of state.json. Never nest two in one process (flock would deadlock)."""

    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.fh = open(os.path.join(STATE_DIR, "state.lock"), "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        try:
            self.state = read_json_strict(STATE_PATH, {}) or {}
        except Exception:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()
            raise
        for k in ("jobs", "running", "alerts", "baselines"):
            self.state.setdefault(k, {})
        return self.state

    def __exit__(self, *exc):
        try:
            write_json(STATE_PATH, self.state)
        finally:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()
        return False


def read_state():
    st = read_json_strict(STATE_PATH, {}) or {}
    for k in ("jobs", "running", "alerts", "baselines"):
        st.setdefault(k, {})
    return st


