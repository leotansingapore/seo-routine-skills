        kind = re.sub(r"-\d+$", "", kind)
        if kind not in seen or len(latest) < 3:
            latest.append("%s (%s)" % (r, kind))
            seen.add(kind)
        if len(latest) >= limit:
            break
    return latest


def changesets_summary(slug, since=None):
    out = []
    for cid, cs in sorted((read_json(sp(slug)["changes"], {}) or {}).items()):
