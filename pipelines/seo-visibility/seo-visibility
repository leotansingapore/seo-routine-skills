TAMPERED = 97


def guarded_files(cwd):
    """Files an agent must never change: global policy, plus the ledgers of the site whose lock this run holds."""
    files = [CONFIG_PATH, SELF] + [sp(x)["site"] for x in site_slugs()]
    files += glob.glob(os.path.join(PROMPTS, "*.md")) + glob.glob(os.path.join(ROOT, "bin", "*"))
    real = os.path.realpath(cwd)
    for slug in site_slugs():
        if real.startswith(os.path.realpath(os.path.join(WORK, slug))) or real.startswith(os.path.realpath(sp(slug)["dir"])):
            files += [sp(slug)["backlog"], sp(slug)["changes"]]
    return [f for f in files if os.path.isfile(f)]


def operator_edit_since(t0):
    """True when `seo-visibility operator-edit` was run after t0 (an operator deliberately changed policy or code)."""
    try:
        return os.path.getmtime(os.path.join(STATE_DIR, "operator-edit.stamp")) >= t0
    except OSError:
        return False


def claude(cfg, kind, prompt, cwd, log_path, add_dirs):
    t0 = time.time()
    snapshot = {}
    for f in guarded_files(cwd):
        try:
            with open(f, "rb") as fh:
                snapshot[f] = fh.read()
        except OSError:
            pass
    rc = _claude(cfg, kind, prompt, cwd, log_path, add_dirs)
    tampered = []
    operator = operator_edit_since(t0)
    for f, before in snapshot.items():
        try:
            with open(f, "rb") as fh:
                now_bytes = fh.read()
        except OSError:
            now_bytes = None
        if now_bytes != before:
            if operator:
                log("tripwire: %s changed during a %s run after an operator-edit stamp; kept (operator update)" % (f, kind))
                continue
            with open(f, "wb") as fh:
                fh.write(before)
            tampered.append(f)
    if tampered:
        log("TAMPER: %s run changed %s; restored" % (kind, ", ".join(tampered)))
        alert_once("tamper", "SEO visibility: a %s agent modified pipeline policy files (%s). They were restored from "
                   "the pre-run copy and the run was discarded." % (kind, ", ".join(os.path.basename(t) for t in tampered)),
                   every_hours=6)
        return TAMPERED
    return rc


LAST_DEFER = {"why": "usage limit", "timeout": False}   # why the last claude call returned 75


def _claude(cfg, kind, prompt, cwd, log_path, add_dirs):
    mcp = os.path.join(STATE_DIR, "no-mcp.json")
    if not os.path.exists(mcp):
        write_json(mcp, {"mcpServers": {}})
    args = ["gtimeout", "--kill-after=60", "%dm" % cfg["timeouts_min"].get(kind, 90),
            "/bin/bash", RESILIENT, "-p", prompt, "--model", cfg["models"].get(kind, "opus"),
            "--dangerously-skip-permissions", "--mcp-config", mcp, "--strict-mcp-config"]
    for d in add_dirs:
        args += ["--add-dir", d]
    env = dict(os.environ, PATH=PATH_ENV, SEO_VISIBILITY_RUN="1")
    with open(log_path, "ab") as lf:
        lf.write(("\n==== %s %s model=%s\n" % (iso(), kind, cfg["models"].get(kind))).encode())
        lf.flush()
        start = lf.tell()
        p = subprocess.run(args, cwd=cwd, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, env=env)
    rc = p.returncode
    if rc == 124:
        # gtimeout killed it: a hang or an oversized job, not a quota. Saying "usage limit" hid this for weeks.
        LAST_DEFER["why"] = "timed out after %dm" % cfg["timeouts_min"].get(kind, 90)
        LAST_DEFER["timeout"] = True
        log("claude %s timed out after %dm" % (kind, cfg["timeouts_min"].get(kind, 90)))
        return 75
    LAST_DEFER.update(why="no output (launch failure)", timeout=False)
    try:
        with open(log_path, "rb") as f:
            f.seek(start)
            produced = len(f.read().strip())
    except OSError:
        produced = 1
    if produced == 0:
        # the CLI exited without writing a single byte and claude-resilient logged no outcome (seen 2026-09-15
        # 10:51): a transient launch failure, not a run that decided to do nothing
        log("claude %s produced no output at all (rc=%s); treating as transient" % (kind, rc))
        return 75
    if rc not in (0, 75):
        try:
            with open(log_path, "rb") as f:
                f.seek(start)
                tail = f.read()[-4000:].decode("utf-8", "replace")
        except OSError:
            tail = ""
        if LIMIT_RE.search(tail):
            note_limit(tail)
            LAST_DEFER["why"] = "usage limit"
            return 75
        if TRANSIENT_RE.search(tail):
            LAST_DEFER["why"] = "transient API error"
            log("claude %s hit a transient API/network error; deferring: %s" % (kind, tail.strip()[-160:]))
            return 75
    return rc


